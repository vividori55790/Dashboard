# ======================================================================
# Git Ignore Rules for TelemetryDashboard (.NET 8 WPF & Python Infrastructure)
# ======================================================================

# 1. Visual Studio & .NET 컴파일 결과물 (C# / WPF Build Artifacts)
# 이유: bin/ 및 obj/ 폴더는 C# 컴파일 시 자동 생성되는 바이너리와 중간 캐시 파일입니다.
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# 2. Visual Studio 개인 설정 및 사용자 캐시 (VS User Settings & Cache)
# 이유: .vs/ 폴더, .suo, .user 파일 등은 개발자 개인 IDE 상태/창 위치 정보로 깃 추적에서 제외합니다.
.vs/
*.user
*.userosv
*.suo
*.userprefs
*.sln.docstates

# 3. 게시 및 배포 바이너리 폴더 (Publish & Distribution Directories)
# 이유: 단일 .exe 추출 및 배포용 빌드 결과물은 용량이 크며 언제든 명령어로 재생성 가능합니다.
dist/
dist_vs/
dist_framework_dependent/
dist_single_file/
build/

# 4. Python 가상환경 및 런타임 캐시 (Python Virtual Environment & Bytecode)
.venv/
venv/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd

# 5. 애플리케이션 로그 & 임시 파일 (Application Logs & Temp Files)
*.log
*.tmp

# 6. IDE 및 OS 시스템 파일 (IDE & OS System Files)
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
# ======================================================================
# Superseded Python prototype and agent scratch
# ======================================================================
# Archive/ holds the pre-.NET Python application, moved aside rather than
# deleted so it stays available locally. Its content is already in git
# history (the deletions in this commit), so tracking a second copy would
# store every file twice, __pycache__ and PyInstaller output included.
Archive/

# PyInstaller output of that prototype: 155 MB of build artefacts.
publish/
publish_single/

# Working notes from agent runs. Process, not product.
.agents/

# Blame/hang dumps from `dotnet test --blame`; multi-hundred-MB and machine-specific.
TestResults/
