<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TelemetryDashboard.UI</RootNamespace>
    <AssemblyName>TelemetryDashboard.UI</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <NoWarn>$(NoWarn);NU1701;NU1603</NoWarn>
    <ApplicationIcon>..\..\Logo_Gemini.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\Logo_Gemini.png">
      <Link>Logo_Gemini.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Logo_Gemini.ico">
      <Link>Logo_Gemini.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\*.html">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\telemetry-client.js">
      <Link>telemetry-client.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\WEB_VISUALIZATION_GUIDE.md">
      <Link>WEB_VISUALIZATION_GUIDE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="HelixToolkit.WPF" Version="2.25.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Wpf.Ui" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelemetryDashboard.Core\TelemetryDashboard.Core.csproj" />
    <ProjectReference Include="..\TelemetryDashboard.Infrastructure\TelemetryDashboard.Infrastructure.csproj" />

    <!--
      Build order only; the host must not compile against the plugin.

      A normal reference drops the plugin next to the host executable, on the default
      AssemblyLoadContext's probing path. Anything that resolves it there — the host itself, or a
      dependency walk out of the collectible context — loads it into the default context, where it
      can never be unloaded, so hot reload silently stops working. It also means the load path
      being exercised is not the one a genuine third-party plugin takes: discovery of a file the
      host was never built against. StagePlugins below puts the output where that discovery looks.
    -->
    <ProjectReference Include="..\TelemetryDashboard.Plugins\TelemetryDashboard.Plugins.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Copies the sample plugin into the host's plugins/ directory. Asking the plugin project for its
    own TargetPath keeps this correct across configurations and target frameworks; a hardcoded
    bin\Debug\net8.0 path silently stops copying the day either changes.

    RuntimeIdentifier is cleared deliberately. `dotnet publish -r <rid>` sets it as a global
    property that flows into this MSBuild call, so GetTargetPath answers with a RID-qualified path
    the plugin project never built to, and the publish fails with MSB3030 on a missing file. The
    plugin is a plain net8.0 library with one output for every RID, so asking without a RID is both
    correct and the only thing that survives a RID-targeted publish.
  -->
  <Target Name="StagePlugins" AfterTargets="Build">
    <MSBuild Projects="..\TelemetryDashboard.Plugins\TelemetryDashboard.Plugins.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false">
      <Output TaskParameter="TargetOutputs" ItemName="StagedPluginAssembly" />
    </MSBuild>

    <Copy SourceFiles="@(StagedPluginAssembly)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
