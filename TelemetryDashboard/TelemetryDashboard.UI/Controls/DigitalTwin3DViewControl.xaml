<UserControl x:Class="TelemetryDashboard.UI.Controls.DigitalTwin3DViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helix="http://helix-toolkit.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="#13141C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 3D View Control Bar -->
        <Border Grid.Row="0" Background="#1E1E2E" Padding="8,6" Margin="4" CornerRadius="6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🧊 3D DIGITAL TWIN MODEL (HELIX TOOLKIT)" Foreground="#89DDFF" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnResetView" Content="🎯 Reset View" Width="90" Click="BtnResetView_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnToggleGrid" Content="🌐 Toggle Grid" Width="90" Click="BtnToggleGrid_Click"/>
                </StackPanel>
                <TextBlock x:Name="OrientationText" Text="Roll: 0.0° | Pitch: 0.0° | Yaw: 0.0°" Foreground="#A9B1D6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Helix Viewport 3D -->
        <helix:HelixViewport3D x:Name="Viewport3D" Grid.Row="1" Margin="4" ShowFrameRate="True" ShowCoordinateSystem="True" Background="#181926">
            <helix:DefaultLights/>
            <helix:GridLinesVisual3D x:Name="GridLines" Width="20" Length="20" MajorDistance="5" MinorDistance="1" Thickness="0.03" Fill="#3B4252"/>

            <!-- 3D Cube / Board Model -->
            <helix:BoxVisual3D x:Name="TwinBox" Width="6" Length="4" Height="1" Fill="#7AA2F7"/>
        </helix:HelixViewport3D>
    </Grid>
</UserControl>
