<!--
    Lock screen.

    The label used to read "Unlock Password (Default: admin123):" and the failure message read
    "Incorrect Password! Try 'admin123'". A lock screen that prints the credential it is checking
    protects nothing, and printing it twice does not help the person who set a real one.

    The card is bounded by MinWidth and MaxWidth rather than a fixed Width, so a longer message in
    any language grows the card instead of being clipped by it.
-->
<UserControl x:Class="TelemetryDashboard.UI.Controls.PasswordLockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{StaticResource InsetColor}" Opacity="0.94"/>
        </Grid.Background>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="340" MaxWidth="420"
                Style="{StaticResource Card}" Padding="24">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="Screen locked"
                           HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,20"
                           Text="The dashboard keeps running. Enter the password to get back to it."/>

                <TextBlock Style="{StaticResource LabelText}" Text="Password"/>
                <Border Background="{StaticResource InsetBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusS}" Margin="0,6,0,16">
                    <PasswordBox x:Name="TxtPassword"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 FontFamily="{StaticResource UiFont}"
                                 FontSize="{StaticResource FontSizeBody}"
                                 MinHeight="{StaticResource ControlHeight}"
                                 Padding="8,5" VerticalContentAlignment="Center"
                                 KeyDown="TxtPassword_KeyDown"/>
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Content="Unlock"
                        HorizontalAlignment="Stretch" Click="BtnUnlock_Click"/>

                <TextBlock x:Name="TxtError" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource DangerBrush}"
                           Text="That password was not accepted."
                           HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
