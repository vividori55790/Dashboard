<!--
    Lock screen.

    The label used to read "Unlock Password (Default: admin123):" and the failure message read
    "Incorrect Password! Try 'admin123'". A lock screen that prints the credential it is checking
    protects nothing, and printing it twice does not help the person who set a real one. The
    literal is gone from the product entirely; there is no default password now.

    So this panel has two jobs, not one. On an installation that has never had a password it asks
    the operator to choose one, because the honest answer to "what is the initial password" is that
    there isn't one. On every other launch it asks for the password that was chosen. Which of the
    two is showing is decided in code from the credential store, not by a flag someone can leave in
    the wrong state.

    The card is bounded by MinWidth and MaxWidth rather than a fixed Width, so a longer message in
    any language grows the card instead of being clipped by it.
-->
<UserControl x:Class="TelemetryDashboard.UI.Controls.PasswordLockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             IsVisibleChanged="OnIsVisibleChanged">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{Binding Color, Source={StaticResource ScrimStrongBrush}}" Opacity="0.94"/>
        </Grid.Background>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="360" MaxWidth="460"
                Style="{StaticResource Card}" Padding="24">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Style="{StaticResource TitleText}" Text="Screen locked"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtCaption" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,20"
                           Text="The dashboard keeps running. Enter the password to get back to it."/>

                <TextBlock x:Name="LblPassword" Style="{StaticResource LabelText}" Text="Password"/>
                <Border Background="{StaticResource InsetBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusS}" Margin="0,6,0,16">
                    <PasswordBox x:Name="TxtPassword"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 FontFamily="{StaticResource UiFont}"
                                 FontSize="{StaticResource FontSizeBody}"
                                 MinHeight="{StaticResource ControlHeight}"
                                 Padding="8,5" VerticalContentAlignment="Center"
                                 KeyDown="TxtPassword_KeyDown"/>
                </Border>

                <!-- Enrollment only. Typing a new password once and getting it wrong locks the
                     operator out of their own machine at the next restart, so it is typed twice. -->
                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource LabelText}" Text="Repeat the password"/>
                    <Border Background="{StaticResource InsetBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusS}" Margin="0,6,0,16">
                        <PasswordBox x:Name="TxtConfirm"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     FontFamily="{StaticResource UiFont}"
                                     FontSize="{StaticResource FontSizeBody}"
                                     MinHeight="{StaticResource ControlHeight}"
                                     Padding="8,5" VerticalContentAlignment="Center"
                                     KeyDown="TxtPassword_KeyDown"/>
                    </Border>
                </StackPanel>

                <Button x:Name="BtnAction" Style="{StaticResource PrimaryButton}" Content="Unlock"
                        HorizontalAlignment="Stretch" Click="BtnUnlock_Click"/>

                <TextBlock x:Name="TxtError" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource DangerBrush}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Text="That password was not accepted."
                           HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>

                <TextBlock x:Name="TxtHint" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
