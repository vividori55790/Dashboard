<UserControl x:Class="TelemetryDashboard.UI.Controls.PasswordLockOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#EE090A0F">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Style="{StaticResource CardStyle}" Padding="24">
            <StackPanel>
                <TextBlock Text="🔒 SYSTEM LOCKED" Foreground="#FF5555" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Telemetry Dashboard Screen Protection" Foreground="#A9B1D6" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <TextBlock Text="Unlock Password (Default: admin123):" Foreground="#C0CAF5" FontSize="11" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPassword" Background="#16161E" Foreground="#9ECE6A" BorderBrush="#3B4252" Padding="8" FontSize="14" KeyDown="TxtPassword_KeyDown" Margin="0,0,0,12"/>

                <Button Content="🔓 UNLOCK DASHBOARD" Padding="12,8" Background="#00E676" Foreground="#101014" FontWeight="Bold" FontSize="12" Click="BtnUnlock_Click"/>
                <TextBlock x:Name="TxtError" Text="Incorrect Password! Try 'admin123'" Foreground="#FF5555" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
