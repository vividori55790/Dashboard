<!--
    Operator control panel.

    This is the right-hand dock pane, so it is laid out for a narrow column rather than for the
    designer's canvas. Everything scrolls vertically, nothing scrolls horizontally, labels trim and
    messages wrap, and a MinWidth stops the splitter squeezing it below the point where the
    readings are legible. The previous version assumed roughly 700px and lost the right-hand third
    of every heading and stat at the width it actually gets.
-->
<UserControl x:Class="TelemetryDashboard.UI.Controls.ControlPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="288"
             d:DesignHeight="880" d:DesignWidth="400">
    <UserControl.Resources>
        <!-- Section container. One padding, one gap, so the panel has a rhythm instead of a
             per-section opinion about its own margins. -->
        <Style x:Key="PanelSection" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Headline reading tile. -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="TileCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Right-hand value in a label/value row. -->
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Supporting statistics: mono so the figures align, caption weight so they stay
             subordinate to the reading they describe. -->
        <Style x:Key="StatsNote" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- BasedOn, or the whole design system is dropped: a keyed Button style replaces the
             dictionary's implicit one rather than extending it, and these four quick commands were
             rendering as stock light-grey Windows buttons inside a dark panel. -->
        <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="LogMeta" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="16,16,16,0">

                <!-- ==================== Live readings ==================== -->
                <Border Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Live readings"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileCaption}" Text="Packets"/>
                                    <TextBlock x:Name="TxtPacketCount" Style="{StaticResource MetricText}"
                                               Text="0" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileCaption}" Text="Rate, KB/s"/>
                                    <!-- A dash until a full timing window has elapsed. "0.0 KB/s"
                                         before the first measurement is a reading nothing took. -->
                                    <TextBlock x:Name="TxtDataRate" Style="{StaticResource MetricText}"
                                               Text="—" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                       Text="Temperature, min / max"/>
                            <TextBlock Grid.Column="1" x:Name="TxtTempMinMax"
                                       Style="{StaticResource RowValue}" Text="—"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                       Text="Vibration, peak"/>
                            <TextBlock Grid.Column="1" x:Name="TxtVibMax"
                                       Style="{StaticResource RowValue}" Text="—"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Node control ==================== -->
                <Border Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Node control and sampling"/>

                        <ToggleButton x:Name="BtnNodeCom3Power" Content="Node COM3 (DAB): On"
                                      IsChecked="True" Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch" Click="BtnNodeCom3Power_Click"/>
                        <ToggleButton x:Name="BtnNodeCom4Power" Content="Node COM4 (PSFB): On"
                                      IsChecked="True" Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch" Click="BtnNodeCom4Power_Click"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnZeroCalibration" Content="Zero calibration"
                                    Click="BtnZeroCalibration_Click"/>
                            <ToggleButton Grid.Column="2" x:Name="BtnBurstMode" Content="Burst: 1 Hz"
                                          IsChecked="False" Click="BtnBurstMode_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Anomaly detection ==================== -->
                <Border Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Anomaly detection"/>

                        <TextBlock Style="{StaticResource LabelText}" Text="Temperature"/>
                        <!-- Both readings start as a dash: a z-score of 0.0 labelled NORMAL before
                             any baseline exists is the panel asserting something it cannot know. -->
                        <TextBlock x:Name="TxtTempZScore" Style="{StaticResource MonoText}"
                                   Text="—" TextTrimming="CharacterEllipsis" Margin="0,2,0,12"/>

                        <TextBlock Style="{StaticResource LabelText}" Text="Vibration"/>
                        <TextBlock x:Name="TxtVibZScore" Style="{StaticResource MonoText}"
                                   Text="—" TextTrimming="CharacterEllipsis" Margin="0,2,0,12"/>

                        <TextBlock x:Name="TxtAnomalyStats" Style="{StaticResource StatsNote}"
                                   Text="No samples analysed yet"/>
                    </StackPanel>
                </Border>

                <!-- ==================== Temperature trend ==================== -->
                <Border Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Temperature trend"/>
                        <Border Background="{StaticResource InsetBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusS}" Height="56" Padding="1">
                            <Grid>
                                <Canvas x:Name="CanvasSparkline" ClipToBounds="True"/>
                                <!-- Named so the code can retire it the moment there is a line to
                                     draw. An empty plot area otherwise reads as a flat zero. -->
                                <TextBlock x:Name="TxtSparklineEmpty" Style="{StaticResource CaptionText}"
                                           Text="Waiting for samples"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource CaptionText}" Text="Last 50 temperature samples"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ==================== Event log ==================== -->
                <Border Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}"
                                    Content="Clear" Click="BtnClearLog_Click"/>
                            <CheckBox DockPanel.Dock="Right" x:Name="ChkAutoScroll" Content="Auto-scroll"
                                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SubtitleText}" Text="Event log"
                                       Margin="0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!--
                            A list rather than a grid. Seven fixed-width columns needed about 500px
                            and this pane is given 400, so the message column — the only one that
                            says what happened — was squeezed to a few characters. Every field the
                            grid carried is still here; the row simply wraps instead of clipping.
                        -->
                        <!-- RequestBringIntoView is handled here so auto-scroll stays inside the
                             list. The event log scrolls itself to the newest row several times a
                             second; left to bubble, each of those requests asked every ScrollViewer
                             above it to bring the log into view as well, which walked the whole
                             panel downward and left it opening part-way through its own content
                             with the live readings scrolled off the top. -->
                        <ListBox x:Name="DgEventLog" MinHeight="180" MaxHeight="320"
                                 HorizontalContentAlignment="Stretch"
                                 RequestBringIntoView="DgEventLog_RequestBringIntoView"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="LevelBar" Grid.Column="0"
                                                Background="{StaticResource BorderDefaultBrush}"
                                                CornerRadius="2" Margin="0,1,10,1"/>

                                        <StackPanel Grid.Column="1">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource LogMeta}"
                                                           Text="{Binding Time}" Margin="0,0,8,0"/>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource LogMeta}"
                                                           Text="{Binding Node}" Margin="0,0,6,0"/>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource LogMeta}"
                                                           Text="{Binding Variable}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="ReadingText" DockPanel.Dock="Right"
                                                           Style="{StaticResource LogMeta}"
                                                           Text="{Binding Reading}"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                                            <Setter TargetName="LevelBar" Property="Background"
                                                    Value="{StaticResource WarningBrush}"/>
                                            <Setter TargetName="ReadingText" Property="Foreground"
                                                    Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="CRIT">
                                            <Setter TargetName="LevelBar" Property="Background"
                                                    Value="{StaticResource DangerBrush}"/>
                                            <Setter TargetName="ReadingText" Property="Foreground"
                                                    Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- ==================== Command transmitter ==================== -->
                <Border Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Send command to MCU"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CommandButton}"
                                    Content="Start telemetry" Click="QuickCmd_Click" Tag="START_TELEMETRY"/>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CommandButton}"
                                    Content="Stop telemetry" Click="QuickCmd_Click" Tag="STOP_TELEMETRY"/>
                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CommandButton}"
                                    Content="Get status" Click="QuickCmd_Click" Tag="GET_STATUS"/>
                            <!-- Reset restarts the hardware, which is the one command here that
                                 cannot be taken back. -->
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DangerButton}"
                                    Content="Reset MCU" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Click="QuickCmd_Click" Tag="RESET_MCU"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCustomCmd" Grid.Column="0" FontFamily="{StaticResource MonoFont}"
                                     KeyDown="TxtCustomCmd_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Send"
                                    Margin="8,0,0,0" Click="BtnSendCustomCmd_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Text="Type a raw command and press Enter."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Pinned: the last thing the panel did should not scroll out of sight. -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock x:Name="TxtSystemStatus" Style="{StaticResource CaptionText}"
                       Text="No commands sent yet" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
