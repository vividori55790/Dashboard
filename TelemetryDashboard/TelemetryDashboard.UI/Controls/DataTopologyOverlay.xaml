<UserControl x:Class="TelemetryDashboard.UI.Controls.DataTopologyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="700">
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="NodeCardStyle">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#1A1B26" BorderBrush="#3B4252" BorderThickness="1" CornerRadius="10" Padding="12" Margin="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="10" Height="10" Fill="#00E676" Margin="0,0,8,0" x:Name="StatusLed"/>
                    <TextBlock Text="ORGANIC DATA TOPOLOGY NETWORK" Foreground="#89DDFF" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="ThroughputText" Text="Data Stream: Active (60 Hz)" Foreground="#A9B1D6" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- Canvas Links & Nodes Grid -->
            <Grid Grid.Row="1">
                <Canvas x:Name="LinkCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Node 1: Source -->
                    <Border Grid.Column="0" Style="{StaticResource NodeCardStyle}" x:Name="NodeSource" Cursor="Hand" MouseLeftButtonDown="Node_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔌 " FontSize="12"/>
                                <TextBlock Text="DATA SOURCE" Foreground="#BB9AF7" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock x:Name="SourceDetailsText" Text="COM3/COM4 Sim" Foreground="#C0CAF5" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Telemetry Rx" Foreground="#7AA2F7" FontSize="9" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Arrow 1 -->
                    <TextBlock Grid.Column="1" Text=" ➔ " Foreground="#7AA2F7" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Node 2: Parser -->
                    <Border Grid.Column="2" Style="{StaticResource NodeCardStyle}" x:Name="NodeParser" Cursor="Hand" MouseLeftButtonDown="Node_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚙️ " FontSize="12"/>
                                <TextBlock Text="PACKET PARSER" Foreground="#7AA2F7" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Framing &amp; CRC" Foreground="#C0CAF5" FontSize="10"/>
                            <TextBlock x:Name="ParserStatsText" Text="Valid: 99.9%" Foreground="#9ECE6A" FontSize="9" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Arrow 2 -->
                    <TextBlock Grid.Column="3" Text=" ➔ " Foreground="#7AA2F7" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Node 3: Formula Engine -->
                    <Border Grid.Column="4" Style="{StaticResource NodeCardStyle}" x:Name="NodeEngine" Cursor="Hand" MouseLeftButtonDown="Node_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🧮 " FontSize="12"/>
                                <TextBlock Text="FORMULA EVAL" Foreground="#E0AF68" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Signal Processing" Foreground="#C0CAF5" FontSize="10"/>
                            <TextBlock x:Name="EngineStatsText" Text="Expressions Active" Foreground="#7AA2F7" FontSize="9" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Arrow 3 -->
                    <TextBlock Grid.Column="5" Text=" ➔ " Foreground="#7AA2F7" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Node 4: Outputs -->
                    <Border Grid.Column="6" Style="{StaticResource NodeCardStyle}" x:Name="NodeOutputs" Cursor="Hand" MouseLeftButtonDown="Node_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📊 " FontSize="12"/>
                                <TextBlock Text="OUTPUT VIEWS" Foreground="#7DCFFF" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="2D Scope / 3D Twin" Foreground="#C0CAF5" FontSize="10"/>
                            <TextBlock Text="Control Log" Foreground="#00E676" FontSize="9" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
