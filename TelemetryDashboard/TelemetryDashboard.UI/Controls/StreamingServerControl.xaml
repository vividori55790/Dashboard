<!--
    Streaming server console.

    Every number on this panel now starts as a dash. The defaults shipped here were "1 Client
    Connected" and "Total Broadcasted: 1,420 pkts (60 Hz)" — a specific, calm, entirely invented
    state that a panel showed before the server had been asked anything, and which looked exactly
    like a healthy running server.

    The URLs are filled in from the server's actual port rather than written into the markup, so a
    server started on any other port stops advertising an address nothing is listening on.
-->
<UserControl x:Class="TelemetryDashboard.UI.Controls.StreamingServerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="PanelSection" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="UrlBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Header ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="16,16,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenWebConsole" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="BtnOpenWebConsole_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE774;" Margin="0,0,8,0"/>
                            <TextBlock Text="웹 시각화 콘솔 열기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnToggleServer" Click="BtnToggleServer_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ServerToggleGlyph" Style="{StaticResource IconText}"
                                       Text="&#xE71A;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ServerToggleLabel" Text="서버 정지" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse x:Name="ServerLed" Width="10" Height="10" Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource TextTertiaryBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TitleText}" Text="Streaming server"/>
                        <TextBlock x:Name="TxtServerEndpoint" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Endpoint not known until a server is attached"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Metrics and integration ==================== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource PanelSection}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource CaptionText}" Text="Connected clients"/>
                            <TextBlock x:Name="TxtClientCount" Style="{StaticResource MetricText}"
                                       Text="—" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource CaptionText}" Text="Frames broadcast"/>
                            <TextBlock x:Name="TxtBroadcastStats" Style="{StaticResource MetricText}"
                                       Text="—" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Connecting a client"/>

                        <TextBlock Style="{StaticResource LabelText}" Text="WebSocket"/>
                        <TextBox x:Name="TxtWsUrl" Style="{StaticResource UrlBox}"
                                 Text="Not available until the server is attached"/>

                        <TextBlock Style="{StaticResource LabelText}" Text="HTTP status"/>
                        <TextBox x:Name="TxtHttpUrl" Style="{StaticResource UrlBox}"
                                 Text="Not available until the server is attached"/>

                        <Button HorizontalAlignment="Left" Click="BtnCopyWsUrl_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Margin="0,0,8,0"/>
                                <TextBlock Text="WebSocket URL 복사" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Any WebSocket client can subscribe to the stream, and any HTTP client can poll the status endpoint."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="What this server does"/>
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="이 시스템은 고성능 텔레메트리 데이터 수집, 시계열 보관 및 실시간 변환 파이프라인 전용 허브입니다. 모든 수신 데이터는 웹소켓 표준 프로토콜로 브로드캐스트되어 사용자가 개조한 HTML 클라이언트(stream_client.html)나 외부 전용 모니터링 앱으로 즉시 전달됩니다."/>

                    <Separator Margin="0,16"/>

                    <TextBlock Style="{StaticResource LabelText}" Text="Bundled web client page"/>
                    <TextBlock x:Name="TxtHtmlPath" Style="{StaticResource MonoText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="No path attached yet" TextWrapping="Wrap" Margin="0,4,0,12"/>

                    <Button HorizontalAlignment="Left" Click="BtnOpenHtmlLocation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Margin="0,0,8,0"/>
                            <TextBlock Text="파일 위치 열기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
