<!--
    Real-time scope.

    No button here sets a Width. The previous toolbar measured each caption once, in English, and
    froze the result, so the captions read "Pause Scop", "Clear D" and "Auto F" on the machine this
    was screenshotted on. MinWidth and padding come from the button style and grow with whatever
    the caption turns out to be.

    Channel identity is carried by a swatch beside the name rather than by tinting the label, so the
    legend still says which line is which while the text keeps full reading contrast.
-->
<UserControl x:Class="TelemetryDashboard.UI.Controls.ScopeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:controls="clr-namespace:TelemetryDashboard.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:DataTopologyOverlay x:Name="TopologyOverlay" Grid.Row="0" Margin="12,12,12,0"/>

        <Border Grid.Row="1" Style="{StaticResource Toolbar}" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock x:Name="ScopeStatsText" DockPanel.Dock="Right"
                           Style="{StaticResource MonoText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Samples: 0 | Channels: 0"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- The name is stated because the content is a glyph and a label in a panel,
                         and WPF cannot derive an accessible name from a composite like that: both
                         of these buttons reported an empty name to a screen reader. It is kept in
                         step with the caption in BtnPause_Click. -->
                    <Button x:Name="BtnPause" Margin="0,0,8,0" Click="BtnPause_Click"
                            AutomationProperties.Name="Pause">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseGlyph" Style="{StaticResource IconText}"
                                       Text="&#xE769;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClear" Margin="0,0,8,0" Click="BtnClear_Click"
                            AutomationProperties.Name="Clear">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" Margin="0,0,8,0"/>
                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- No glyph in the sanctioned set means "fit the axes to the data", and a
                         guessed one renders as an empty box, so this one is a plain caption. -->
                    <Button x:Name="BtnAutoFit" Content="Auto fit" Margin="0,0,8,0" Click="BtnAutoFit_Click"/>
                    <!--
                        One shared axis cannot show 1,200 rpm and 0.2 g at the same time: the small
                        channels are flattened onto the floor and read as dead. Scaling each channel
                        into a common band makes them all legible, at the cost of an axis that no
                        longer carries units — so the axis says so when this is on, and the legend
                        carries each channel's real range. A chart that silently renormalises is
                        showing shapes while implying values.
                    -->
                    <!-- Measurement cursors. A scope you can only watch answers "is it moving";
                         an engineer's next question is always "how long was that, and how big",
                         and that needs two points and the difference between them. -->
                    <ToggleButton x:Name="BtnCursors" Content="Cursors" Margin="0,0,8,0"
                                  ToolTip="Click the plot twice to measure the time and value between two points."
                                  Checked="BtnCursors_Changed" Unchecked="BtnCursors_Changed"/>
                    <ToggleButton x:Name="BtnFitEach" Content="Fit each" Margin="0,0,16,0"
                                  ToolTip="Scale every channel into a common band so small ones stay readable. Values move to the legend."
                                  Checked="BtnFitEach_Changed" Unchecked="BtnFitEach_Changed"/>
                </StackPanel>

                <!-- Channel toggles are generated from the channels actually received,
                     so the scope is not limited to one fixed sensor set. -->
                <ItemsControl x:Name="ChannelToggles" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border Width="10" Height="10" CornerRadius="{StaticResource RadiusS}"
                                        Background="{Binding Brush}" VerticalAlignment="Center"
                                        Margin="0,0,6,0"/>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Checked="Channel_CheckChanged" Unchecked="Channel_CheckChanged"/>
                                <!-- Empty unless the scope is scaling per channel, at which point
                                     the axis stops carrying units and this is where they went. -->
                                <TextBlock Text="{Binding ScaleNote}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ScottPlot:WpfPlot x:Name="MainPlot" Margin="12"
                               MouseLeftButtonDown="MainPlot_CursorClick"/>

            <!-- The readout sits over the plot rather than in the toolbar, because it is read while
                 looking at the trace. IsHitTestVisible is off so it never swallows a click meant
                 for the canvas underneath it. -->
            <Border x:Name="CursorHud" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,24,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusS}" Padding="12,8">
                <StackPanel>
                    <TextBlock x:Name="CursorDeltaText" Style="{StaticResource MonoText}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Click the plot to place the first cursor."/>
                    <TextBlock x:Name="CursorPointsText" Style="{StaticResource MonoText}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,4,0,0" Text=""/>
                    <TextBlock x:Name="CursorNoteText" Style="{StaticResource MonoText}"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="0,4,0,0" Text="" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
