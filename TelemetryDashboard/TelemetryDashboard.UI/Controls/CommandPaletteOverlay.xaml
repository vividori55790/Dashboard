<UserControl x:Class="TelemetryDashboard.UI.Controls.CommandPaletteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid Background="#80000000">
        <Border Width="600" VerticalAlignment="Top" Margin="0,50,0,0"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#40FFFFFF">
            <StackPanel>
                <TextBox x:Name="SearchBox" FontSize="14" Padding="8"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                <ListBox x:Name="CommandListBox" MaxHeight="300" Margin="0,8,0,0"
                         SelectionChanged="CommandListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding Category}" Foreground="#888888" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
