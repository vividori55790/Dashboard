<!--
    Command palette.

    The list template used to bind Name and Category, but the service it is filled from returns a
    plain list of command names, so both bindings resolved against a string that has neither
    property and every row rendered blank. It binds the item itself now. Category is not shown
    because the service does not return one — an empty column is not a category.

    The panel also had no affordances at all: an unlabelled text box, and no indication that Enter
    runs the selection or that Escape closes the palette, both of which the code-behind implements.
-->
<UserControl x:Class="TelemetryDashboard.UI.Controls.CommandPaletteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid>
        <!-- Scrim: the canvas colour at partial opacity, so it dims the window without introducing
             a second black of its own. -->
        <Grid.Background>
            <SolidColorBrush Color="{StaticResource CanvasColor}" Opacity="0.72"/>
        </Grid.Background>

        <Border MinWidth="420" MaxWidth="640" VerticalAlignment="Top" Margin="0,72,0,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusL}" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0"
                               VerticalAlignment="Center" Text="Run a command"/>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>

                <ListBox x:Name="CommandListBox" MaxHeight="320" Margin="0,10,0,0"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="CommandListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                           Text="Arrow keys to move · Enter to run · Esc to close"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
