<Window x:Class="TelemetryDashboard.UI.Dialogs.AdaptiveSamplingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="적응형 샘플링"
        Height="640" Width="880" MinHeight="540" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeBody}"
        KeyDown="Window_KeyDown">

    <!--
        The grid below is the one thing on this screen an operator has to trust: it says what rate
        each channel is sampling at right now. Its values come from the controller, so the styles
        here only decide how they look, never what they say.
    -->
    <Window.Resources>
        <Style x:Key="DataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DataGridBodyCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridBodyRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="적응형 샘플링"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="평시에는 낮은 속도로 로깅하다가, 채널의 Z-Score가 임계값을 넘으면 버스트 속도로 전환해 과도 구간을 촘촘히 기록합니다."/>
        </StackPanel>

        <!-- Parameters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleText}" Text="파라미터"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"
                               Text="평시 속도" Margin="0,0,12,8"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,8">
                        <TextBox x:Name="TxtBaseRate" MinWidth="84" TextAlignment="Right"/>
                        <TextBlock Style="{StaticResource LabelText}" Text="Hz" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelText}"
                               Text="버스트 속도" Margin="0,0,12,8"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="TxtBurstRate" MinWidth="84" TextAlignment="Right"/>
                        <TextBlock Style="{StaticResource LabelText}" Text="Hz" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"
                               Text="이상치 임계값" Margin="0,0,12,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBox x:Name="TxtThreshold" MinWidth="84" TextAlignment="Right"/>
                        <TextBlock Style="{StaticResource LabelText}" Text="σ (Z-Score)" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}"
                               Text="쿨다운" Margin="0,0,12,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                        <TextBox x:Name="TxtCooldown" MinWidth="84" TextAlignment="Right"/>
                        <TextBlock Style="{StaticResource LabelText}" Text="초 (이상 해제 후 유지)" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Live state -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SubtitleText}" Text="채널별 상태" Margin="0"/>
                    <TextBlock x:Name="TxtCurrentMode" Style="{StaticResource BodyText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="DgChannelSampling"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserResizeRows="False"
                          RowHeight="32" SelectionMode="Single"
                          Background="{DynamicResource InsetBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                          RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          ColumnHeaderStyle="{StaticResource DataGridHeader}"
                          CellStyle="{StaticResource DataGridBodyCell}"
                          RowStyle="{StaticResource DataGridBodyRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="채널" Binding="{Binding ChannelName}" Width="Auto"/>
                        <DataGridTextColumn Header="현재 속도" Binding="{Binding CurrentRate}" Width="Auto"/>
                        <DataGridTextColumn Header="모드" Binding="{Binding Mode}" Width="Auto"/>
                        <DataGridTextColumn Header="최근 Z-Score" Binding="{Binding LastZScore}" Width="Auto"/>
                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="아래 두 동작은 컨트롤러에 직접 Z-Score를 입력해 전환 로직을 확인하는 시험용입니다. 하드웨어에서 측정한 값이 아닙니다."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="임계값 초과 값 주입" Margin="0,0,8,0" Click="BtnTriggerSurge_Click"/>
                        <Button Content="평시로 복귀" Margin="0,0,12,0" Click="BtnResetNormal_Click"/>
                        <TextBlock x:Name="TxtTestStatus" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="닫기" Margin="0,0,8,0" Click="BtnClose_Click"/>
            <Button Content="저장하고 적용" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
