<Window x:Class="TelemetryDashboard.UI.Dialogs.AdaptiveSamplingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ 1Hz ↔ 1000Hz 지능형 가변 샘플링 제어기 (Adaptive Dynamic Sampling)" 
        Height="620" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14"
        Foreground="#F0F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Guide -->
            <RowDefinition Height="Auto"/> <!-- Config Box -->
            <RowDefinition Height="*"/>    <!-- Live Channels Status & Simulation -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚡ 지능형 가변 샘플링 제어기 (Adaptive Dynamic Sampling)" Foreground="#00FF9D" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="💡 동작 원리: 정상 상태에서는 1~5 Hz로 저대역폭/저전력 로깅을 유지하다가, Z-Score 2.5σ 이상의 이상치 서지가 감지되면 1000 Hz 초고속 버스트 모드로 즉각 전환하여 과도 현상을 0.001초 단위로 정밀 캡처합니다." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Parameters Card -->
        <Border Grid.Row="1" Background="#18202C" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="평시 기본 속도 (Nominal Rate):" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,10">
                    <TextBox x:Name="TxtBaseRate" Text="1" Width="60" TextAlignment="Center"/>
                    <TextBlock Text="Hz (초당 1회)" Foreground="#8B949E" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="이상시 버스트 속도 (Burst Rate):" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="TxtBurstRate" Text="1000" Width="60" TextAlignment="Center"/>
                    <TextBlock Text="Hz (초당 1,000회)" Foreground="#00FF9D" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="이상치 임계값 (Z-Score Threshold):" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBox x:Name="TxtThreshold" Text="2.5" Width="60" TextAlignment="Center"/>
                    <TextBlock Text="σ (Sigma)" Foreground="#FFB800" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="히스테리시스 쿨다운 (Cooldown):" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                    <TextBox x:Name="TxtCooldown" Text="5.0" Width="60" TextAlignment="Center"/>
                    <TextBlock Text="초 (이상 해제 후 유지)" Foreground="#8B949E" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Status & Test Trigger Panel -->
        <Border Grid.Row="2" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="📊 실시간 채널별 샘플링 상태" Foreground="#00F0FF" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtCurrentMode" Text="모드: 🟢 NOMINAL (1 Hz)" Foreground="#00FF9D" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- DataGrid for channels -->
                <DataGrid Grid.Row="1" x:Name="DgChannelSampling" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#0E131A" Foreground="#F0F6FC" BorderBrush="#283548" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="채널 / 노드" Binding="{Binding ChannelName}" Width="160"/>
                        <DataGridTextColumn Header="현재 주파수" Binding="{Binding CurrentRate}" Width="110"/>
                        <DataGridTextColumn Header="동작 모드" Binding="{Binding Mode}" Width="130"/>
                        <DataGridTextColumn Header="최근 Z-Score" Binding="{Binding LastZScore}" Width="110"/>
                        <DataGridTextColumn Header="상태 플래그" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Test Triggers -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="⚡ 강제 3.5σ 서지 발생 (1000Hz 전환 테스트)" Padding="12,6" Background="#FF2E63" Foreground="#FFF" FontWeight="Bold" Margin="0,0,8,0" Click="BtnTriggerSurge_Click"/>
                    <Button Content="🔄 정상 상태 복귀 (1Hz 쿨다운)" Padding="10,6" Background="#18202C" Margin="0,0,8,0" Click="BtnResetNormal_Click"/>
                    <TextBlock x:Name="TxtTestStatus" Text="Ready" Foreground="#8B949E" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="💾 설정 저장 &amp; 적용" HorizontalAlignment="Left" Padding="14,6" Background="#00F0FF" Foreground="#0B0E14" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="닫기" HorizontalAlignment="Right" Padding="12,6" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
