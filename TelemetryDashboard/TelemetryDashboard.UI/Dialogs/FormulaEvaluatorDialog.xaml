<Window x:Class="TelemetryDashboard.UI.Dialogs.FormulaEvaluatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="수식 평가기"
        Height="600" Width="860" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeBody}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="수식 평가기"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="채널 값을 조합한 파생 신호 수식의 문법을 확인합니다. 예: Power_KW = [COM3].Voltage * [COM3].Current / 1000"/>
        </StackPanel>

        <!-- Expression -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleText}" Text="수식"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtExpression" FontFamily="{StaticResource MonoFont}"
                             Text="Power_KW = [COM3].Voltage * [COM3].Current / 1000"
                             KeyDown="TxtExpression_KeyDown"/>
                    <Button Grid.Column="1" Content="검증" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Margin="8,0,0,0" Click="BtnEvaluate_Click"/>
                </Grid>
                <TextBlock x:Name="TxtValueSource" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubtitleText}" Text="평가 기록"/>
                <ListBox x:Name="LstEvalResults" FontFamily="{StaticResource MonoFont}"/>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,16,0"
                       Text="사용 가능한 함수: abs(), sqrt(), sin(), cos(), min(), max(), round()"/>
            <Button Grid.Column="1" Content="닫기" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
