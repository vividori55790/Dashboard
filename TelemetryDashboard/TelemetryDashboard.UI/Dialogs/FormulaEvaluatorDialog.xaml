<Window x:Class="TelemetryDashboard.UI.Dialogs.FormulaEvaluatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧮 Dynamic Signal Formula Evaluator Engine" 
        Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#13141C" Foreground="#C0CAF5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧮 DYNAMIC SIGNAL FORMULA EVALUATOR" Foreground="#89DDFF" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <TextBlock Text="Evaluates real-time derived formulas (e.g. Power = V * I, Temp_K = Temp_C + 273.15)" Foreground="#A9B1D6" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Formula Expression Input -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="수식 입력 (Expression):" Foreground="#7AA2F7" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtExpression" Text="Power_KW = [COM3].Voltage * [COM3].Current / 1000" Background="#16161E" Foreground="#9ECE6A" FontFamily="Consolas" FontSize="13" Padding="6" KeyDown="TxtExpression_KeyDown"/>
                    <Button Content="⚡ 수식 검증 &amp; 테스트 연산" Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Click="BtnEvaluate_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Evaluation Results Log -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📊 LIVE FORMULA EVALUATION OUTPUT" Foreground="#E0AF68" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                <ListBox x:Name="LstEvalResults" Grid.Row="1" Background="#16161E" BorderBrush="#3B4252" Foreground="#C0CAF5" FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock Text="Supported Functions: abs(), sqrt(), sin(), cos(), min(), max(), round()" Foreground="#565F89" FontSize="10" VerticalAlignment="Center"/>
            <Button Content="닫기" Width="90" Padding="10,4" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
