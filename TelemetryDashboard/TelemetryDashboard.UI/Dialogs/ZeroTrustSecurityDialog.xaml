<!--
    A bench for two primitives: AES-256-GCM and the Gorilla compressor.

    This window was titled "Zero-Trust 보안" and read as a security configuration screen, but nothing
    it does affects the application: the key it generates is used only by the text box below it, and
    no telemetry path consults it. The header also promised the compressor saves "90% 이상" of memory
    bandwidth, and the four metric tiles shipped pre-filled with 8,000 bytes, 688 bytes, 11.6:1 and
    91.4% — a result for a specific synthetic signal, displayed before any benchmark had run. The
    tiles now start empty and the caption says where mesh encryption is actually configured.
-->
<Window x:Class="TelemetryDashboard.UI.Dialogs.ZeroTrustSecurityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="암호화 및 압축 검증"
        Height="680" Width="860" MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource TitleText}" Text="암호화 및 압축 검증 (Crypto and compression bench)"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="AES-256-GCM 암·복호화와 Gorilla 시계열 압축을 직접 실행해 동작을 확인하는 창입니다."/>
        </StackPanel>

        <!-- What this window does not do. It reads as a settings screen and is not one. -->
        <Border Grid.Row="1" Margin="0,0,0,12"
                Background="{DynamicResource WarningSubtleBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusS}" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE946;"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"
                           VerticalAlignment="Top"/>
                <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"
                           Text="여기서 만든 키는 이 창 안에서만 쓰입니다. 실제 텔레메트리나 저장 파일에는 적용되지 않으며, 메시 트래픽 암호화는 [클러스터 메시] 창의 클러스터 암호구절로 설정합니다."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="AES-256-GCM">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubtitleText}" Text="키"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource LabelText}"
                                           Margin="0,0,12,0" Text="256비트 마스터 키"/>
                                <TextBox Grid.Column="1" x:Name="TxtAesKey" Margin="0,0,8,0"
                                         IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                                <Button Grid.Column="2" Content="새 키 생성" MinWidth="110"
                                        Click="BtnGenerateKey_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="창을 열 때마다 난수로 새로 만들어지며 저장되지 않습니다. 창을 닫으면 이 키로 만든 암호문은 복호화할 수 없습니다."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubtitleText}" Text="평문"/>
                            <TextBox x:Name="TxtPlaintext" MinHeight="60" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalContentAlignment="Top"
                                     FontFamily="{StaticResource MonoFont}"
                                     Text="{}{&quot;nodeId&quot;:&quot;COM3&quot;,&quot;channel&quot;:&quot;temp&quot;,&quot;value&quot;:94.6}"/>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="예시로 채워진 문자열입니다. 측정값이 아니라 암호화 입력일 뿐입니다."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}"
                                       Text="암호문 및 인증 태그"/>
                            <TextBox Grid.Row="1" x:Name="TxtCiphertext"
                                     Style="{StaticResource ConsoleTextBox}" TextWrapping="Wrap"
                                     Text="암호화를 실행하면 nonce, 암호문, 인증 태그가 여기에 표시됩니다."/>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="3">
                        <TextBlock x:Name="TxtAesStatus" Style="{StaticResource CaptionText}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="대기 중"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="복호화 검증" Margin="0,0,8,0" Click="BtnDecrypt_Click"/>
                            <Button Content="암호화" Style="{StaticResource PrimaryButton}" MinWidth="100"
                                    Click="BtnEncrypt_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Gorilla 압축">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubtitleText}" Text="측정 결과"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource LabelText}" Text="원본"/>
                                    <TextBlock x:Name="TxtRawSize" Style="{StaticResource MetricText}"
                                               Margin="0,4,0,0" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource LabelText}" Text="압축 후"/>
                                    <TextBlock x:Name="TxtCompressedSize" Style="{StaticResource MetricText}"
                                               Margin="0,4,0,0" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource LabelText}" Text="압축비"/>
                                    <TextBlock x:Name="TxtRatio" Style="{StaticResource MetricText}"
                                               Margin="0,4,0,0" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{StaticResource LabelText}" Text="절감률"/>
                                    <TextBlock x:Name="TxtSavings" Style="{StaticResource MetricText}"
                                               Margin="0,4,0,0" Text="—"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="압축률은 데이터에 따라 달라집니다. 아래 벤치마크는 매끄럽게 변하는 합성 파형을 입력으로 쓰므로, 실제 계측 신호에서는 다른 값이 나옵니다."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}"
                                       Text="실행 기록"/>
                            <TextBox Grid.Row="1" x:Name="TxtGorillaLog"
                                     Style="{StaticResource ConsoleTextBox}" TextWrapping="Wrap"
                                     Text="벤치마크를 실행하면 결과가 여기에 표시됩니다."/>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2">
                        <TextBlock x:Name="TxtGorillaStatus" Style="{StaticResource CaptionText}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="대기 중"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                                MinWidth="180" Content="합성 샘플 1,000개로 벤치마크"
                                Click="BtnRunGorillaBenchmark_Click"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="닫기" HorizontalAlignment="Right" IsCancel="True" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
