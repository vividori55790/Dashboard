<Window x:Class="TelemetryDashboard.UI.Dialogs.TimeTravelDvrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⏱️ Time-Travel DVR Packet Replay &amp; AI Incident Report Center" 
        Height="640" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14"
        Foreground="#F0F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Timeline Scrubber & Speed Controls -->
            <RowDefinition Height="*"/>    <!-- Replay Data Snapshot & Incident Report -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⏱️ Time-Travel DVR 0.1s Precision Replayer" Foreground="#00F0FF" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Scrub backward in time, replay telemetry states with variable speed, and export 1-click post-mortem incident reports" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Scrubber & Controls Card -->
        <Border Grid.Row="1" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Scrubber Slider -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTimelineStart" Text="-60.0s (Past)" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider Grid.Column="1" x:Name="SliderTimeline" Minimum="-60.0" Maximum="0.0" Value="0.0" 
                            TickFrequency="5.0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="SliderTimeline_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="TxtTimelineCurrent" Text="0.0s [LIVE]" Foreground="#00FF9D" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <!-- Replay & Speed Buttons -->
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnTogglePlay" Content="▶️ 재생 (Play)" Background="#00FF9D" Foreground="#0B0E14" FontWeight="Bold" Padding="12,6" Margin="0,0,6,0" Click="BtnTogglePlay_Click"/>
                        <Button Content="⏹️ 현재(Live)로 이동" Padding="10,6" Margin="0,0,6,0" Click="BtnJumpLive_Click"/>
                        <Button Content="⚡ 이상치 시점으로 점프 (Jump Anomaly)" Background="#331018" BorderBrush="#FF2E63" Foreground="#FF2E63" Padding="10,6" Margin="0,0,6,0" Click="BtnJumpAnomaly_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="속도:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="0.5x" Padding="8,4" Click="SpeedBtn_Click" Tag="0.5"/>
                        <Button Content="1.0x" Padding="8,4" Background="#00F0FF" Foreground="#0B0E14" Click="SpeedBtn_Click" Tag="1.0"/>
                        <Button Content="2.0x" Padding="8,4" Click="SpeedBtn_Click" Tag="2.0"/>
                        <Button Content="5.0x" Padding="8,4" Click="SpeedBtn_Click" Tag="5.0"/>
                        <Button Content="10x" Padding="8,4" Click="SpeedBtn_Click" Tag="10.0"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Replay Snapshot & Incident Report -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Replay Channel Values -->
            <Border Grid.Column="0" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📊 해당 시점 텔레메트리 스냅샷 (Replay Frame)" Foreground="#66FCF1" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="DgReplaySnapshot" Background="#0E131A" Foreground="#F0F6FC"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#283548"
                              RowBackground="#0E131A" AlternatingRowBackground="#141B24" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Channel" Binding="{Binding ChannelName}" Width="110"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="75"/>
                            <DataGridTextColumn Header="Z-Score" Binding="{Binding ZScore}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Incident Report Preview -->
            <Border Grid.Column="1" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📑 1-Click AI 사고 분석 리포트" Foreground="#00F0FF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="🔄 리포트 갱신" Padding="6,2" FontSize="10" HorizontalAlignment="Right" Click="BtnRefreshReport_Click"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtIncidentReport" Background="#0E131A" Foreground="#F0F6FC" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="DVR Status: Ready | 600 Frames Cached" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📋 리포트 복사" Padding="10,6" Margin="0,0,6,0" Click="BtnCopyReport_Click"/>
                <Button Content="💾 리포트 저장 (.md)" Padding="10,6" Margin="0,0,6,0" Click="BtnSaveReport_Click"/>
                <Button Content="닫기" Padding="12,6" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
