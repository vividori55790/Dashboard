<!--
    Time-travel DVR.

    Three classes of thing were fixed here beyond the colours.

    The emoji: play, stop, refresh and the section markers were all colour-font glyphs, which ignore
    Foreground, so they were the only marks the palette could not reach. Play, pause, stop and
    refresh have proper glyphs in the sanctioned icon set; the "jump to anomaly" command has none,
    so it is a plain caption rather than a guessed glyph that renders as an empty box.

    The status line opened reading "DVR Status: Ready | 600 Frames Cached" before the player had
    been asked anything. Nothing counted those six hundred frames. It now opens saying that it has
    not looked yet, and the first thing the dialog does is look.

    The snapshot grid was a DataGrid with four hardcoded column widths, which is how a status column
    ends up too narrow to read the one sentence it exists to carry. It is a list now, on the
    application's own list styles, and the row grows to fit its text.
-->
<Window x:Class="TelemetryDashboard.UI.Dialogs.TimeTravelDvrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="타임트래블 DVR"
        Height="640" Width="920" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- BasedOn, always: a keyed Button style replaces the dictionary's implicit one instead of
             extending it, and a transport row without it renders as three stock Windows buttons. -->
        <Style x:Key="TransportCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SpeedCommand" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ColumnHeading" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- scrubber and transport -->
            <RowDefinition Height="*"/>     <!-- snapshot and report -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource TitleText}" Text="타임트래블 DVR"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="보관된 프레임을 되감아 재생하고, 재생 중인 구간에 대한 사고 리포트를 만듭니다."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtTimelineStart" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,12,0" Text="-60.0초 (과거)"/>

                    <Slider Grid.Column="1" x:Name="SliderTimeline" Minimum="-60.0" Maximum="0.0" Value="0.0"
                            TickFrequency="5.0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="SliderTimeline_ValueChanged"/>

                    <TextBlock Grid.Column="2" x:Name="TxtTimelineCurrent" Style="{StaticResource MonoText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" Text="0.0s [LIVE]"/>
                </Grid>

                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnTogglePlay" Style="{StaticResource TransportCommand}"
                                Click="BtnTogglePlay_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PlayGlyph" Style="{StaticResource IconText}"
                                           Text="&#xE768;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="PlayLabel" Text="재생" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TransportCommand}" Click="BtnJumpLive_Click"
                                ToolTip="재생을 멈추고 현재 시각으로 돌아갑니다.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" Margin="0,0,8,0"/>
                                <TextBlock Text="현재로 이동" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- No glyph in the sanctioned set means "jump to the flagged frame", and a
                             guessed one renders as an empty box, so this one is a plain caption. -->
                        <Button Content="이상치 시점으로 이동" Style="{StaticResource TransportCommand}"
                                Click="BtnJumpAnomaly_Click"
                                ToolTip="분석기가 실제로 이상으로 판정한 가장 최근 프레임으로 재생 헤드를 옮깁니다."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="속도" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="0.5x" Style="{StaticResource SpeedCommand}" Click="SpeedBtn_Click" Tag="0.5"/>
                        <Button Content="1.0x" Style="{StaticResource SpeedCommand}" Click="SpeedBtn_Click" Tag="1.0"/>
                        <Button Content="2.0x" Style="{StaticResource SpeedCommand}" Click="SpeedBtn_Click" Tag="2.0"/>
                        <Button Content="5.0x" Style="{StaticResource SpeedCommand}" Click="SpeedBtn_Click" Tag="5.0"/>
                        <Button Content="10x" Style="{StaticResource SpeedCommand}" Click="SpeedBtn_Click" Tag="10.0"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== Snapshot under the playhead ==================== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}"
                               Text="재생 시점의 텔레메트리"/>

                    <Grid Grid.Row="1" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="64"/>
                            <ColumnDefinition Width="Auto" MinWidth="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeading}" Text="채널"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeading}"
                                   Text="측정값" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeading}"
                                   Text="Z-점수" TextAlignment="Right"/>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="DgReplaySnapshot"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="64"/>
                                            <ColumnDefinition Width="Auto" MinWidth="64"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource MonoText}"
                                                   Text="{Binding ChannelName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                   Text="{Binding Value}" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MonoText}"
                                                   Text="{Binding ZScore}" TextAlignment="Right"/>
                                    </Grid>
                                    <!-- The status wraps rather than being clipped: it is the only
                                         field that says whether anyone examined the frame. -->
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               Text="{Binding Status}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ==================== Incident report ==================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}"
                                Click="BtnRefreshReport_Click" ToolTip="현재 구간으로 리포트를 다시 만듭니다.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Margin="0,0,8,0"/>
                                <TextBlock Text="다시 만들기" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource SubtitleText}" Margin="0"
                                   VerticalAlignment="Center" Text="사고 리포트"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBox Grid.Row="1" x:Name="TxtIncidentReport"
                             Style="{StaticResource ConsoleTextBox}"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <!-- Opens saying it has not looked yet. It used to open claiming 600 cached frames,
                 which nothing had counted. -->
            <TextBlock x:Name="TxtStatus" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="DVR 재생: 아직 구간을 읽지 않았습니다"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnCopyReport_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Margin="0,0,8,0"/>
                        <TextBlock Text="리포트 복사" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="BtnSaveReport_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,0,8,0"/>
                        <TextBlock Text="리포트 저장" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="닫기" Style="{StaticResource PrimaryButton}" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
