<!--
    Anomaly detection settings and the anomalies the running engine has actually recorded.

    This window used to invent four channel names, push randomised readings through the live
    engine and present the resulting z-scores as "real-time anomaly scores". Every number on the
    screen described data the hardware had never produced, and the injected samples corrupted the
    rolling statistics the rest of the application depends on. Nothing here originates a value:
    the list shows what the engine recorded, and an engine that has recorded nothing says so.
-->
<Window x:Class="TelemetryDashboard.UI.Dialogs.MlAnalyticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이상 감지 분석"
        Height="560" Width="880" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="이상 감지 분석 (Anomaly detection)"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="수신 중인 채널을 롤링 z-score로 판정합니다. 이 창은 판정 기준을 조정하고, 엔진이 실제로 기록한 이상치만 표시합니다."/>
        </StackPanel>

        <!-- Threshold. The only control on this screen that changes anything. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleText}" Text="판정 기준"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Margin="0,0,12,0"
                               Text="이상치 임계값 (z-score)"/>
                    <Slider Grid.Column="1" x:Name="SldThreshold"
                            Minimum="1.5" Maximum="4.0" Value="2.5"
                            SmallChange="0.1" LargeChange="0.5"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="SldThreshold_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="TxtThresholdVal" Style="{StaticResource MonoText}"
                               MinWidth="72" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="2.5 σ"/>
                </Grid>

                <TextBlock x:Name="TxtEngineInfo" Style="{StaticResource CaptionText}"
                           Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="—"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recorded anomalies. Not "all channels": the engine retains only what it flagged. -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SubtitleText}" Margin="0,0,0,2"
                                   Text="기록된 이상치"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="임계값을 넘어 판정된 채널만 남습니다. 정상 채널은 여기 나타나지 않습니다."/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LstAnomalyScores"
                             FontFamily="{StaticResource MonoFont}"
                             HorizontalContentAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Forecasts, derived from the same recorded results rather than computed here. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SubtitleText}" Margin="0,0,0,2"
                                   Text="추세 외삽"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="기록 당시의 기울기를 60초 뒤로 선형 연장한 값입니다. 예측이 아니라 외삽입니다."/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LstForecasts"
                             FontFamily="{StaticResource MonoFont}"
                             HorizontalContentAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtRecordedAt" Style="{StaticResource CaptionText}"
                       DockPanel.Dock="Left" VerticalAlignment="Center" Text="—"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="목록 지우기" Margin="0,0,8,0" Click="BtnClearAnomalies_Click"/>
                <Button Content="새로 고침" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                <Button Content="닫기" IsCancel="True" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
