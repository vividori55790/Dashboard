<Window x:Class="TelemetryDashboard.UI.Dialogs.ProtocolBridgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏭 산업용 프로토콜 게이트웨이 브릿지 (CAN Bus / Modbus RTU / ROS2)" 
        Height="650" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14"
        Foreground="#F0F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Protocol Selector & Raw Hex Input -->
            <RowDefinition Height="*"/>    <!-- Converted Telemetry JSON View -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🏭 Industrial &amp; Robotics Protocol Bridge Gateway" Foreground="#00FF9D" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="이종 산업용 프로토콜(CAN 2.0B / CAN-FD, Modbus RTU/TCP, ROS2 / Micro-XRCE-DDS) 프레임을 TelemetryDashboard 표준 JSON 패킷으로 실시간 변환/라우팅합니다." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Protocol Input -->
        <Border Grid.Row="1" Background="#18202C" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="프로토콜 선택:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="CboProtocol" Width="240" HorizontalAlignment="Left" SelectionChanged="CboProtocol_SelectionChanged">
                        <ComboBoxItem Content="CAN Bus (0x123 8-Byte Frame)" IsSelected="True"/>
                        <ComboBoxItem Content="Modbus RTU (Slave 1, Func 0x03)"/>
                        <ComboBoxItem Content="ROS2 Telemetry Bridge Packet"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="⚡ 프레임 변환 실행" Padding="12,6" Background="#00F0FF" Foreground="#0B0E14" FontWeight="Bold" Click="BtnConvert_Click"/>
                </Grid>

                <TextBlock Text="Raw Byte Payload (Hex String):" Foreground="#8B949E" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtRawHex" Background="#0E131A" Foreground="#00FF9D" FontFamily="Consolas" FontSize="12" Padding="6"
                         Text="08 00 23 01 00 00 00 00 48 42"/>
            </StackPanel>
        </Border>

        <!-- JSON Output Preview -->
        <Border Grid.Row="2" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 TelemetryDashboard Unified JSON Output:" Foreground="#00F0FF" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="TxtConvertedJson" Background="#0E131A" Foreground="#F0F6FC" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="Wrap" Text="변환된 JSON 패킷이 여기에 표시됩니다."/>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="📋 JSON 복사" HorizontalAlignment="Left" Padding="10,6" Click="BtnCopyJson_Click"/>
            <Button Content="닫기" HorizontalAlignment="Right" Padding="12,6" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
