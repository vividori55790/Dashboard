<!--
    Industrial frame decoder, run by hand against a pasted payload.

    The combo box was labelled "프로토콜 선택" and changed nothing but the sample bytes: the bridge
    identifies a frame by sniffing it, never by what is selected here. A control that appears to
    choose the decoder while the decoder ignores it is worse than no control, so it now says what it
    does — it loads an example frame — and the output card states whether the sniff actually matched.
-->
<Window x:Class="TelemetryDashboard.UI.Dialogs.ProtocolBridgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로토콜 브리지"
        Height="620" Width="840" MinHeight="500" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="프로토콜 브리지 (Protocol bridge)"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="CAN, Modbus RTU, ROS2 프레임을 바이트 패턴으로 식별해 표준 JSON 패킷으로 바꿉니다. 여기서는 한 프레임을 직접 넣어 결과를 확인할 수 있습니다."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleText}" Text="입력 프레임"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Margin="0,0,12,0"
                               Text="예제 불러오기"/>
                    <ComboBox Grid.Column="1" x:Name="CboProtocol" HorizontalAlignment="Left"
                              MinWidth="280" SelectionChanged="CboProtocol_SelectionChanged">
                        <ComboBoxItem Content="CAN — 10바이트 고정 프레임 (0x123, 50.0)" IsSelected="True"/>
                        <ComboBoxItem Content="Modbus RTU — 슬레이브 1, 기능 0x03, 레지스터 1개"/>
                        <ComboBoxItem Content="ROS2 CDR — 토픽 temp, 25.5"/>
                    </ComboBox>
                </Grid>

                <TextBlock Style="{StaticResource LabelText}" Margin="0,0,0,4"
                           Text="바이트 페이로드 (16진수)"/>
                <TextBox x:Name="TxtRawHex" FontFamily="{StaticResource MonoFont}"
                         Text="08 00 23 01 00 00 00 00 48 42"/>

                <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="공백과 0x 접두사는 무시됩니다. 디코더는 선택한 항목이 아니라 바이트 패턴으로 프로토콜을 추정하므로, 어느 것도 맞지 않으면 원본 바이트를 그대로 담은 패킷이 나옵니다."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                               Text="변환 결과"/>
                    <TextBlock x:Name="TxtMatchState" Style="{StaticResource CaptionText}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Text="—"/>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="TxtConvertedJson" Style="{StaticResource ConsoleTextBox}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Text="변환할 프레임을 입력하고 [변환]을 누르세요."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3">
            <TextBlock x:Name="TxtRegistryInfo" Style="{StaticResource CaptionText}"
                       DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="—"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Click="BtnCopyJson_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Margin="0,0,8,0"/>
                        <TextBlock Text="JSON 복사"/>
                    </StackPanel>
                </Button>
                <Button Content="닫기" Margin="0,0,8,0" IsCancel="True" Click="BtnClose_Click"/>
                <Button Content="변환" Style="{StaticResource PrimaryButton}" MinWidth="100"
                        IsDefault="True" Click="BtnConvert_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
