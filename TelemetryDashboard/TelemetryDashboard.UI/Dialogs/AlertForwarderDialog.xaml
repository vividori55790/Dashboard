<Window x:Class="TelemetryDashboard.UI.Dialogs.AlertForwarderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알림 전달"
        Height="660" Width="840" MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeBody}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="알림 전달"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="이상치가 감지되면 파형 요약과 진단 텍스트를 아래 채널로 전달합니다. 주소를 입력한 채널만 전송 대상이 됩니다."/>
        </StackPanel>

        <!-- Destinations -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>

                <!-- Slack -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                                       Text="Slack"/>
                            <CheckBox x:Name="ChkSlack" Content="사용" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSlackWebhook"/>
                            <Button Grid.Column="1" Content="테스트 전송" Margin="8,0,0,0" Click="BtnTestSlack_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Text="Incoming Webhook 주소. 예: https://hooks.slack.com/services/…"/>
                    </Grid>
                </Border>

                <!-- Discord -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                                       Text="Discord"/>
                            <CheckBox x:Name="ChkDiscord" Content="사용" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDiscordWebhook"/>
                            <Button Grid.Column="1" Content="테스트 전송" Margin="8,0,0,0" Click="BtnTestDiscord_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Text="채널 웹훅 주소. 예: https://discord.com/api/webhooks/…"/>
                    </Grid>
                </Border>

                <!-- Telegram -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                                       Text="Telegram"/>
                            <CheckBox x:Name="ChkTelegram" Content="사용" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTelegramToken" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtTelegramChatId"/>
                            <Button Grid.Column="2" Content="테스트 전송" Margin="8,0,0,0" Click="BtnTestTelegram_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Text="왼쪽은 봇 토큰, 오른쪽은 대상 채팅 ID입니다."/>
                    </Grid>
                </Border>

                <!-- Generic webhook -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                                       Text="HTTP 웹훅"/>
                            <CheckBox x:Name="ChkWebhook" Content="사용" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGenericWebhook"/>
                            <Button Grid.Column="1" Content="테스트 전송" Margin="8,0,0,0" Click="BtnTestWebhook_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                   Text="JSON 본문을 POST할 사내 엔드포인트 주소입니다."/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Dispatch log -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubtitleText}" Text="전송 기록"/>
                <TextBox x:Name="TxtDispatchLog" Style="{StaticResource ConsoleTextBox}"
                         Height="96" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtThrottleSummary" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" Margin="0,0,8,0" Click="BtnClose_Click"/>
                <Button Content="설정 적용" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnSave_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
