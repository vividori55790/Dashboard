<Window x:Class="TelemetryDashboard.UI.Dialogs.AlertForwarderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📲 Multi-Channel Alert Forwarder Configuration (Slack / Discord / Telegram / Webhook)" 
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14"
        Foreground="#F0F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Channels Config -->
            <RowDefinition Height="Auto"/> <!-- Test Log Terminal -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📲 Multi-Channel AI Alert Forwarder" Foreground="#00F0FF" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Configure webhooks and bot tokens to automatically forward anomaly waveforms and AI summaries" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Channel Configuration Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Slack Card -->
                <Border Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="💬 Slack Incoming Webhook (Block Kit Rich Cards)" Foreground="#66FCF1" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkSlack" Content="활성화 (Enable)" IsChecked="True" Foreground="#00FF9D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSlackWebhook" Text="https://hooks.slack.com/services/T00/B00/XXXX" FontSize="11"/>
                            <Button Grid.Column="1" Content="🧪 Slack 테스트 전송" Padding="10,4" Margin="6,0,0,0" Click="BtnTestSlack_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Discord Card -->
                <Border Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="🎮 Discord Webhook (Rich Embeds &amp; Color Coded Alerts)" Foreground="#BA68C8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkDiscord" Content="활성화 (Enable)" IsChecked="True" Foreground="#00FF9D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDiscordWebhook" Text="https://discord.com/api/webhooks/12345/XXXX" FontSize="11"/>
                            <Button Grid.Column="1" Content="🧪 Discord 테스트 전송" Padding="10,4" Margin="6,0,0,0" Click="BtnTestDiscord_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Telegram Card -->
                <Border Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="✈️ Telegram Bot API (Markdown Waveforms &amp; Instant Push)" Foreground="#00F0FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkTelegram" Content="활성화 (Enable)" IsChecked="False" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTelegramToken" Text="BOT_TOKEN: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtTelegramChatId" Text="CHAT_ID: @telemetry_alerts" FontSize="11" Margin="4,0,0,0"/>
                            <Button Grid.Column="2" Content="🧪 Telegram 테스트" Padding="10,4" Margin="6,0,0,0" Click="BtnTestTelegram_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Generic Webhook Card -->
                <Border Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="🌐 Generic HTTP/JSON Webhook (Enterprise ERP / SIEM)" Foreground="#FFB800" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkWebhook" Content="활성화 (Enable)" IsChecked="False" Foreground="#8B949E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGenericWebhook" Text="http://api.enterprise.internal/v1/telemetry-alerts" FontSize="11"/>
                            <Button Grid.Column="1" Content="🧪 Webhook 테스트" Padding="10,4" Margin="6,0,0,0" Click="BtnTestWebhook_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Test Log Terminal -->
        <Border Grid.Row="2" Background="#0E131A" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="💻 DISPATCH LOG &amp; HTTP STATUS" Foreground="#8B949E" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDispatchLog" Background="Transparent" Foreground="#00FF9D" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11" Height="70" IsReadOnly="True" TextWrapping="Wrap"
                         Text="[INFO] Multi-Channel Alert Forwarder Ready."/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Rate Limiting: 60s Anomaly Throttling Active" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 설정 저장" Padding="12,6" Background="#00F0FF" Foreground="#0B0E14" FontWeight="Bold" Margin="0,0,6,0" Click="BtnSave_Click"/>
                <Button Content="닫기" Padding="12,6" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
