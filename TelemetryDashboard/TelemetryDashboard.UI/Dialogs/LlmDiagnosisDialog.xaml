<!--
    Natural-language diagnosis.

    The emoji went for the usual reason — a robot, a brain, a lightbulb, a rocket, a fire and a
    shield all render from a colour font that ignores Foreground, so they were the only marks on the
    window the palette could not reach. Where the sanctioned icon set has a glyph that means what the
    command means it is used; where it does not, the button is a plain caption rather than a guessed
    glyph, which renders as an empty box.

    The severity badge opened reading "SEVERITY: CRITICAL" before a single query had run. Nothing had
    assessed anything. It now opens saying no diagnosis has run yet, and the badge takes a status
    colour only once the engine has actually returned a verdict.
-->
<Window x:Class="TelemetryDashboard.UI.Dialogs.LlmDiagnosisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자연어 진단 에이전트"
        Height="780" Width="1020" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="SuggestedQuery" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- provider settings -->
            <RowDefinition Height="Auto"/>  <!-- query -->
            <RowDefinition Height="*"/>     <!-- report -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource TitleText}" Text="자연어 진단 에이전트"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="이번 세션에 기록된 이상 징후를 근거로 진단 리포트를 만듭니다. OpenAI API 키를 넣거나 로컬 Ollama에 연결하면 해당 모델이 분석하고, 아무것도 설정하지 않으면 내장 규칙 엔진이 그대로 동작합니다."/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnToggleConfig" VerticalAlignment="Top"
                        Margin="12,0,0,0" Click="BtnToggleConfig_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Margin="0,0,8,0"/>
                        <TextBlock Text="모델 설정" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ========================= Provider settings ========================= -->
        <Border Grid.Row="1" x:Name="BorderConfig" Style="{StaticResource Card}"
                Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="공급자"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CboProvider"
                          MinWidth="200" Margin="0,0,16,8" HorizontalAlignment="Left"
                          SelectionChanged="CboProvider_SelectionChanged">
                    <ComboBoxItem Content="내장 규칙 엔진 (오프라인)" IsSelected="True"/>
                    <ComboBoxItem Content="OpenAI"/>
                    <ComboBoxItem Content="로컬 Ollama"/>
                    <ComboBoxItem Content="사용자 지정 엔드포인트"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="모델 이름"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtModelName"
                         Text="gpt-4o-mini" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="API 키"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtApiKey" Text="" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="엔드포인트"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtEndpointUrl"
                         Text="https://api.openai.com/v1/chat/completions"/>
            </Grid>
        </Border>

        <!-- ============================== Query =============================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtQuery" Grid.Column="0" KeyDown="TxtQuery_KeyDown"
                             Text="최근 온도 스파이크와 전압 강하 원인을 분석하고 60초 후 예측치를 알려줘"/>

                    <Button Grid.Column="1" x:Name="BtnRunQuery" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="BtnRunQuery_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="0,0,8,0"/>
                            <TextBlock Text="진단 실행" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <WrapPanel>
                    <TextBlock Style="{StaticResource LabelText}" VerticalAlignment="Center"
                               Margin="0,0,8,6" Text="추천 질문"/>
                    <Button Style="{StaticResource SuggestedQuery}" Click="QuickQuery_Click"
                            Content="온도 스파이크 원인"
                            Tag="최근 온도 이상 스파이크 원인과 예측치를 상세 분석해줘"/>
                    <Button Style="{StaticResource SuggestedQuery}" Click="QuickQuery_Click"
                            Content="전력단 서지와 단락"
                            Tag="전압 및 전류 이상 변동과 전력단 상태 진단"/>
                    <Button Style="{StaticResource SuggestedQuery}" Click="QuickQuery_Click"
                            Content="베어링 진동 결함"
                            Tag="진동 센서 Z-Score 이상 수치 및 기계적 마찰 결함 확인"/>
                    <Button Style="{StaticResource SuggestedQuery}" Click="QuickQuery_Click"
                            Content="종합 건전성 요약"
                            Tag="현재 시스템의 모든 채널 상태와 종합 건전성 리포트 요약"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============================== Report ============================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtReportTimestamp" DockPanel.Dock="Right"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="아직 리포트를 만들지 않았습니다"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Border x:Name="BadgeSeverity" Style="{StaticResource Badge}">
                            <TextBlock x:Name="TxtSeverity" Style="{StaticResource LabelText}"
                                       Text="심각도 — 진단 전"/>
                        </Border>
                        <Border Style="{StaticResource Badge}">
                            <TextBlock x:Name="TxtInferenceEngine" Style="{StaticResource LabelText}"
                                       Text="엔진 — 대기 중"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <TextBox Grid.Row="1" x:Name="TxtReportMarkdown"
                         Style="{StaticResource ConsoleTextBox}"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="진단 결과가 마크다운 형식으로 여기에 표시됩니다."/>
            </Grid>
        </Border>

        <!-- ============================== Footer ============================== -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <!-- Throttles a running machine into safe mode. Red is earned here. -->
                <Button x:Name="BtnTriggerEmergencyAction" Style="{StaticResource DangerButton}"
                        Margin="0,0,12,0" Click="BtnTriggerEmergencyAction_Click"
                        ToolTip="$CMD,SAFE_MODE,NODE_1,THROTTLE_50 을 연결된 장비로 전송합니다.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                        <TextBlock Text="긴급 보호 명령 전송" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TxtEmergencyStatus" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="아직 전송하지 않았습니다"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnCopyReport_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Margin="0,0,8,0"/>
                        <TextBlock Text="리포트 복사" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="BtnSaveReport_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,0,8,0"/>
                        <TextBlock Text="리포트 저장" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="닫기" Style="{StaticResource PrimaryButton}" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
