<Window x:Class="TelemetryDashboard.UI.Dialogs.OtaFlasherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ Edge MCU Remote OTA Firmware Flasher (.bin / .hex)" 
        Height="540" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14"
        Foreground="#F0F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Port & File Selection -->
            <RowDefinition Height="Auto"/> <!-- Progress Bar -->
            <RowDefinition Height="*"/>    <!-- Flashing Console Log -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚡ Edge MCU Remote Firmware Flasher" Foreground="#00F0FF" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Over-The-Air (OTA) firmware upload over Serial VCP / IP Bridge without physical programmer" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Configuration Card -->
        <Border Grid.Row="1" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="대상 포트:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CboPort" Width="140" HorizontalAlignment="Left" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="펌웨어 파일:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFirmwarePath" Text="C:\Firmware\mcu_node_v2.1.bin" FontSize="11"/>
                <Button Grid.Row="1" Grid.Column="2" Content="📂 찾아보기..." Padding="10,4" Margin="6,0,0,0" Click="BtnBrowse_Click"/>
            </Grid>
        </Border>

        <!-- Progress Card -->
        <Border Grid.Row="2" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgressStatus" Text="상태: 대기 중 (Ready to Flash)" Foreground="#66FCF1" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="#00FF9D" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                </DockPanel>
                <ProgressBar x:Name="PbFlashProgress" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#00FF9D" Background="#0E131A" BorderBrush="#283548"/>
            </StackPanel>
        </Border>

        <!-- Console Log -->
        <Border Grid.Row="3" Background="#0E131A" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="💻 OTA FLASHING TERMINAL &amp; CRC32 VERIFICATION" Foreground="#8B949E" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" x:Name="TxtLog" Background="Transparent" Foreground="#00FF9D" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"
                         Text="[BOOT] Ready for MCU Bootloader synchronization."/>
            </Grid>
        </Border>

        <!-- Action Footer -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Safety: Bootloader Watchdog Timeout: 3000ms" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnStartFlash" Content="⚡ 펌웨어 플래싱 시작" Padding="14,6" Background="#00FF9D" Foreground="#0B0E14" FontWeight="Bold" Margin="0,0,6,0" Click="BtnStartFlash_Click"/>
                <Button Content="닫기" Padding="12,6" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
