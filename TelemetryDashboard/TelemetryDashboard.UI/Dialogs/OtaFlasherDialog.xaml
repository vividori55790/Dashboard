<!--
    Firmware transfer to an edge MCU bootloader.

    Three things on this screen used to be invented: a default firmware path pointing at a file
    nobody has, a fabricated virtual-port entry offered when the machine has no serial ports at all,
    and a footer promising a 3000 ms bootloader watchdog that exists nowhere in the flasher.
    The transfer parameters shown now are the ones the flasher will actually use, and the banner
    reports whether a bootloader link is attached — without one the start button cannot do anything,
    which is worth saying before the operator selects a file.
-->
<Window x:Class="TelemetryDashboard.UI.Dialogs.OtaFlasherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="펌웨어 전송"
        Height="580" Width="780" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="펌웨어 전송 (Firmware transfer)"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="컴파일된 .bin 또는 .hex 이미지를 부트로더로 청크 단위 전송합니다. 전송 완료는 장치가 CRC32를 확인하고 재부팅해야 확정됩니다."/>
        </StackPanel>

        <!-- Whether a bootloader link exists at all. Shown before anything can be selected. -->
        <Border Grid.Row="1" x:Name="LinkBanner" Margin="0,0,0,12"
                Background="{DynamicResource WarningSubtleBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusS}" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LinkIcon" Style="{StaticResource IconText}" Text="&#xE7BA;"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"
                           VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtLinkState" Style="{StaticResource BodyText}"
                           Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                           Text="부트로더 링크가 연결되지 않았습니다. 전송 경로가 없어 플래싱을 시작할 수 없습니다."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"
                           Margin="0,0,12,8" Text="대상 포트"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CboPort"
                          HorizontalAlignment="Left" MinWidth="200" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"
                           Margin="0,0,12,0" Text="펌웨어 파일"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFirmwarePath" Margin="0,0,8,0"/>
                <Button Grid.Row="1" Grid.Column="2" MinWidth="110" Click="BtnBrowse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Margin="0,0,8,0"/>
                        <TextBlock Text="찾아보기"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                           x:Name="TxtTransferParams" Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0" TextWrapping="Wrap" Text="—"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtProgressStatus" Style="{StaticResource BodyText}"
                               DockPanel.Dock="Left" VerticalAlignment="Center"
                               Text="대기 중"/>
                    <TextBlock x:Name="TxtProgressPercent" Style="{StaticResource MonoText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="0%"/>
                </DockPanel>
                <ProgressBar x:Name="PbFlashProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource InsetBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SubtitleText}" Text="전송 기록"/>
                <TextBox Grid.Row="1" x:Name="TxtLog" Style="{StaticResource ConsoleTextBox}"
                         TextWrapping="NoWrap"
                         Text="[BOOT] 부트로더 동기화 대기 중."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" Margin="0,0,8,0" IsCancel="True" Click="BtnClose_Click"/>
                <Button x:Name="BtnStartFlash" Style="{StaticResource DangerButton}"
                        MinWidth="150" IsEnabled="False" Click="BtnStartFlash_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE898;" Margin="0,0,8,0"/>
                        <TextBlock Text="펌웨어 전송 시작"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
