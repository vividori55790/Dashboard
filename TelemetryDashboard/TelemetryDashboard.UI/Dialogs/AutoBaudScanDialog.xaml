<Window x:Class="TelemetryDashboard.UI.Dialogs.AutoBaudScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="포트 자동 검색"
        Height="520" Width="720" MinHeight="440" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeBody}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="포트 자동 검색"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="시스템이 보고한 직렬 포트를 표준 보드레이트로 차례대로 열어, 알려진 형식의 프레임이 들어오는지 확인합니다."/>
        </StackPanel>

        <!-- Progress -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtProgressPercent" Style="{StaticResource LabelText}"
                               HorizontalAlignment="Right" Margin="12,0,0,0"/>
                </DockPanel>
                <ProgressBar x:Name="ProgScan" Height="6" Minimum="0" Maximum="100" Value="0"
                             Background="{StaticResource InsetBrush}"
                             Foreground="{StaticResource AccentBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"/>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubtitleText}" Text="검색 결과"/>
                <ListBox x:Name="LstDiscoveredPorts"
                         FontFamily="{StaticResource MonoFont}"
                         SelectionChanged="LstDiscoveredPorts_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="BtnRescan" Content="다시 검색" DockPanel.Dock="Left" Click="BtnRescan_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" Margin="0,0,8,0" Click="BtnClose_Click"/>
                <Button x:Name="BtnApply" Content="선택한 포트 적용" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsEnabled="False" Click="BtnApply_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
