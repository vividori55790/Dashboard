<Window x:Class="TelemetryDashboard.UI.Dialogs.PluginSandboxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔌 Hot-Reloading Script Plugin Sandbox Manager (`plugins/`)" 
        Height="540" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#0B0E14"
        Foreground="#F0F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Plugins DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="🔌 Hot-Reloading Script Plugin Sandbox" Foreground="#00F0FF" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Zero-restart live dynamic script execution (C#, Python, JS custom filters &amp; formulas)" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="🔄 플러그인 즉시 리로드" Padding="10,6" Background="#00FF9D" Foreground="#0B0E14" FontWeight="Bold" Margin="0,0,6,0" Click="BtnReload_Click"/>
                <Button Content="📁 plugins/ 폴더 열기" Padding="10,6" Click="BtnOpenFolder_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Plugins DataGrid -->
        <Border Grid.Row="1" Background="#121720" BorderBrush="#283548" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="DgPlugins" Background="#0E131A" Foreground="#F0F6FC"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#283548"
                          RowBackground="#0E131A" AlternatingRowBackground="#141B24" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Plugin Name" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified}" Width="130"/>
                        <DataGridTextColumn Header="Description / File Path" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" x:Name="TxtPluginCount" Text="Active Plugins: 3 loaded from plugins/ directory" Foreground="#8B949E" FontSize="11" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- Action Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Sandbox: Isolated Execution with Resource Clamping &amp; Exception Shielding" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="닫기" HorizontalAlignment="Right" Padding="12,6" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
