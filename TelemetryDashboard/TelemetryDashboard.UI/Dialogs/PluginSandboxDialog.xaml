<!--
    Filter scripts loaded from the plugins/ folder.

    The grid used to list three files that were not there — a .cs, a .py and a .js, all marked
    ACTIVE — on a host whose script engines do not claim .cs at all. Every row now comes from the
    folder itself, and a file no engine can run says so instead of showing green.

    The footer's old claim of "Isolated Execution with Resource Clamping" is gone: plugin code runs
    in this process with the application's own permissions, and describing that as a sandbox told an
    operator it was safe to run something they had not read.
-->
<Window x:Class="TelemetryDashboard.UI.Dialogs.PluginSandboxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="플러그인"
        Height="560" Width="820" MinHeight="440" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="PluginGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Width="6" Opacity="0" Cursor="SizeWE"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PluginGridCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="플러그인 (Plugins)"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="plugins/ 폴더의 스크립트로 수신 텔레메트리를 가공합니다. 파일을 저장하면 다시 읽어 들이므로 프로그램을 재시작할 필요는 없습니다."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                               Text="폴더 내용"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource SubtleButton}" Click="BtnOpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Margin="0,0,8,0"/>
                            <TextBlock Text="폴더 열기"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DataGrid Grid.Row="1" x:Name="DgPlugins"
                          Background="{StaticResource InsetBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                          RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" SelectionMode="Single"
                          FontFamily="{StaticResource UiFont}"
                          FontSize="{StaticResource FontSizeBody}"
                          ColumnHeaderStyle="{StaticResource PluginGridHeader}"
                          CellStyle="{StaticResource PluginGridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="파일" Binding="{Binding Name}" Width="Auto" MinWidth="170"/>
                        <DataGridTextColumn Header="실행 엔진" Binding="{Binding Language}" Width="Auto" MinWidth="110"/>
                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="Auto" MinWidth="90"/>
                        <DataGridTextColumn Header="수정 시각" Binding="{Binding LastModified}" Width="Auto" MinWidth="130"/>
                        <DataGridTextColumn Header="비고" Binding="{Binding Description}" Width="*" MinWidth="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" x:Name="TxtPluginCount" Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0" TextWrapping="Wrap" Text="—"/>
            </Grid>
        </Border>

        <!-- What running a plugin actually costs. This is a warning, not a feature list. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16"
                BorderBrush="{StaticResource WarningBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;"
                           Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"
                           VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Text="플러그인은 이 프로그램과 같은 프로세스에서, 같은 권한으로 실행됩니다."/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="메모리·CPU 제한이나 파일 접근 격리는 적용되지 않습니다. 폴더에 넣기 전에 내용을 확인하세요."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3">
            <TextBlock x:Name="TxtPluginsPath" Style="{StaticResource CaptionText}"
                       DockPanel.Dock="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="—"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" Margin="0,0,8,0" IsCancel="True" Click="BtnClose_Click"/>
                <Button Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnReload_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Margin="0,0,8,0"/>
                        <TextBlock Text="다시 읽기"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
