<Window x:Class="TelemetryDashboard.UI.Dialogs.CHeaderExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="펌웨어 코드 생성"
        Height="700" Width="900" MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeBody}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource TitleText}" Text="펌웨어 코드 생성"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="노드 설정을 STM32 · ESP32 · Arduino용 telemetry_config.h 와 송신 드라이버 소스로 변환합니다."/>
        </StackPanel>

        <!-- Source of the generated code -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtSourceNotice" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtSourceSummary" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Generated code -->
        <TabControl Grid.Row="2">
            <TabItem Header="telemetry_config.h">
                <TextBox x:Name="TxtHeaderCode" Style="{StaticResource ConsoleTextBox}" Margin="0,8,0,0"/>
            </TabItem>
            <TabItem Header="telemetry_driver.c">
                <TextBox x:Name="TxtDriverCode" Style="{StaticResource ConsoleTextBox}" Margin="0,8,0,0"/>
            </TabItem>
        </TabControl>

        <!-- Actions -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="클립보드로 복사" DockPanel.Dock="Left" Click="BtnCopy_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" Margin="0,0,8,0" Click="BtnClose_Click"/>
                <Button Content="파일로 저장" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnSave_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
