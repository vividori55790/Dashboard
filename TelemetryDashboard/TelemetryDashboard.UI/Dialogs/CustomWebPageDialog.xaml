<Window x:Class="TelemetryDashboard.UI.Dialogs.CustomWebPageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 커스텀 웹 시각화 템플릿 &amp; Web SDK 가이드" 
        Height="680" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#13141C" Foreground="#C0CAF5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="🌐 CUSTOM WEB VISUALIZATION &amp; SDK INTEGRATION CENTER" Foreground="#89DDFF" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="프로그램은 데이터 수집/처리를 담당하고, 시각화는 원하는 HTML 템플릿으로 자유롭게 커스텀할 수 있습니다." Foreground="#A9B1D6" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="📁 HTML 템플릿 폴더 열기" HorizontalAlignment="Right" Padding="12,6" Background="#283548" Foreground="#00F0FF" FontWeight="Bold" Click="BtnOpenTemplateFolder_Click"/>
            </DockPanel>
        </Border>

        <!-- Web SDK Integration Snippet -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="⚡ 3초 만에 나만의 HTML에 실시간 데이터 바인딩하는 방법:" Foreground="#00FF9D" FontWeight="Bold" FontSize="12"/>
                    <Button Content="📋 연동 기본 스크립트 복사" HorizontalAlignment="Right" Padding="8,3" Click="BtnCopySdk_Click"/>
                </DockPanel>
                <TextBox Text="&lt;!-- 1. SDK 스크립트 추가 --&gt;&#x0a;&lt;script src=&quot;http://localhost:8080/telemetry-client.js&quot;&gt;&lt;/script&gt;&#x0a;&lt;script&gt;&#x0a;  TelemetryClient.connect('ws://localhost:8080/ws');&#x0a;  TelemetryClient.onData(data =&gt; {&#x0a;    document.getElementById('temp').textContent = data.temp;&#x0a;  });&#x0a;&lt;/script&gt;" 
                         IsReadOnly="True" Background="#0C0E14" Foreground="#9ECE6A" FontFamily="Consolas" FontSize="11" Padding="8" Margin="0,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Available Starter Templates -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📂 즉시 실행 및 수정 가능한 기본 HTML 스타터 템플릿 목록 (Starter Templates)" Foreground="#7AA2F7" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Featured: UPS DAB <-> DB PSFB Power Flow & Anomaly Console -->
                        <Border Background="#1A1828" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="520">
                                    <TextBlock Text="⭐ ⚡ power_ups_psfb_dashboard.html (UPS DAB ⟷ DB PSFB 전력 다이어그램 &amp; 알람)" Foreground="#00F0FF" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="전력망(Grid 380V) ➔ 양방향 DAB(UPS/배터리) ➔ PSFB(48V DB 서버랙) 전력 전달 단선도, 정전/UPS 방전 모드 전환, 실시간 이상치 감지 및 긴급 알람 팝업 콘솔." Foreground="#C0CAF5" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="⚡ 브라우저 실행" HorizontalAlignment="Right" Padding="14,6" Background="#00F0FF" Foreground="#07090E" FontWeight="Bold" Click="BtnLaunchPowerUpsPsfb_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- Template 1: Minimal -->
                        <Border Background="#161622" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="520">
                                    <TextBlock Text="1. ⚡ starter_minimal.html (초간단 실시간 수치 카드)" Foreground="#00FF9D" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="30줄의 가장 직관적인 HTML 파일. 온도/진동/습도/RPM/이상치 카드가 실시간으로 갱신되며 이상 시 붉은색 경고 점멸." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="🌐 브라우저 실행" HorizontalAlignment="Right" Padding="14,6" Background="#00E676" Foreground="#101014" FontWeight="Bold" Click="BtnLaunchMinimal_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- Template 2: Chart & Gauge -->
                        <Border Background="#161622" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="520">
                                    <TextBlock Text="2. 📈 starter_chart_gauge.html (실시간 롤링 차트 &amp; 원형 게이지)" Foreground="#00FF9D" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Chart.js를 연동한 실시간 시계열 스크롤 그래프와 SVG 애니메이션 속도계/부하 게이지 템플릿." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="🌐 브라우저 실행" HorizontalAlignment="Right" Padding="14,6" Background="#00F0FF" Foreground="#101014" FontWeight="Bold" Click="BtnLaunchChartGauge_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- Template 3: Multi-Node Grid -->
                        <Border Background="#161622" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="520">
                                    <TextBlock Text="3. 🎛️ starter_grid_dashboard.html (다채널 센서/노드 반응형 그리드)" Foreground="#E0AF68" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="수신되는 모든 노드와 센서 카드가 자동으로 생성되고, Z-Score 이상 발생 시 카드 테두리가 점멸하는 반응형 모니터." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="🌐 브라우저 실행" HorizontalAlignment="Right" Padding="14,6" Background="#E0AF68" Foreground="#101014" FontWeight="Bold" Click="BtnLaunchGrid_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- Template 4: Full Node Wires & DVR -->
                        <Border Background="#161622" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="520">
                                    <TextBlock Text="4. 🌐 stream_client.html (2D 노드 와이어 &amp; 0.1s 타임트래블 DVR)" Foreground="#BB9AF7" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="노드 드래그앤드롭 연결선, 고속 Canvas 렌더링, 0.1초 정밀 타임트래블 스크러버 및 AI 리포트 생성기." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="🌐 브라우저 실행" HorizontalAlignment="Right" Padding="14,6" Background="#BB9AF7" Foreground="#101014" FontWeight="Bold" Click="BtnLaunchStreamClient_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- Template 5: No-Code Dashboard Builder -->
                        <Border Background="#161622" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Width="520">
                                    <TextBlock Text="5. 🛠️ custom_dashboard.html (노코드 드래그앤드롭 대시보드 빌더)" Foreground="#7AA2F7" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="위젯을 화면에 드래그하여 배치하고 원클릭으로 나만의 custom_dashboard.html 파일로 내보내는 노코드 스튜디오." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="🌐 브라우저 실행" HorizontalAlignment="Right" Padding="14,6" Background="#7AA2F7" Foreground="#101014" FontWeight="Bold" Click="BtnLaunchDashboard_Click"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="💡 모든 템플릿 파일은 프로젝트 루트 폴더에 위치하며, 메모장이나 VS Code로 열어 자유롭게 디자인을 수정할 수 있습니다." Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="닫기" HorizontalAlignment="Right" Width="90" Padding="10,6" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
