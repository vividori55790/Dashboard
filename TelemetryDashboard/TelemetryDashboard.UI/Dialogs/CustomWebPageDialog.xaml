<Window x:Class="TelemetryDashboard.UI.Dialogs.CustomWebPageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="웹 시각화 템플릿"
        Height="700" Width="900" MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource FontSizeBody}"
        KeyDown="Window_KeyDown">

    <!-- One row shape for every template: name, one line of description, one action. -->
    <Window.Resources>
        <Style x:Key="TemplateRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TemplateName" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TemplateNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,16,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TitleText}" Text="웹 시각화 템플릿"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="수집과 처리는 이 프로그램이 맡고, 화면은 원하는 HTML로 직접 구성할 수 있습니다. 아래 템플릿은 내장 웹 서버(localhost:8080)가 실행 중일 때 열립니다."/>
        </StackPanel>

        <!-- SDK snippet -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                               Text="내 HTML에 실시간 데이터 연결하기"/>
                    <Button Content="스크립트 복사" HorizontalAlignment="Right" Click="BtnCopySdk_Click"/>
                </DockPanel>
                <TextBox Style="{StaticResource ConsoleTextBox}" MinHeight="136"
                         Text="&lt;!-- 1. SDK 스크립트 추가 --&gt;&#x0a;&lt;script src=&quot;http://localhost:8080/telemetry-client.js&quot;&gt;&lt;/script&gt;&#x0a;&lt;script&gt;&#x0a;  TelemetryClient.connect('ws://localhost:8080/ws');&#x0a;  TelemetryClient.onData(data =&gt; {&#x0a;    document.getElementById('temp').textContent = data.temp;&#x0a;  });&#x0a;&lt;/script&gt;"/>
            </DockPanel>
        </Border>

        <!-- Starter templates -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubtitleText}" Text="스타터 템플릿"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--
                            Neutral starters first, the worked example last.

                            This list opened with one customer's converter dashboard, so the first
                            thing anybody evaluating the templates read was somebody else's power
                            chain. The file is still shipped and still described in full — it is a
                            genuinely useful sample — but it is labelled as an example of what can be
                            built rather than presented as the shape of the product.
                        -->
                        <Border Style="{StaticResource TemplateRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TemplateName}" Text="starter_minimal.html"/>
                                    <TextBlock Style="{StaticResource TemplateNote}"
                                               Text="가장 단순한 형태. 온도·진동·습도·RPM 카드가 갱신되고 이상치일 때 카드가 붉게 표시됩니다."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="브라우저에서 열기" VerticalAlignment="Center"
                                        Click="BtnLaunchMinimal_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TemplateRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TemplateName}" Text="starter_chart_gauge.html"/>
                                    <TextBlock Style="{StaticResource TemplateNote}"
                                               Text="Chart.js 시계열 그래프와 SVG 게이지를 함께 쓰는 구성."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="브라우저에서 열기" VerticalAlignment="Center"
                                        Click="BtnLaunchChartGauge_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TemplateRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TemplateName}" Text="starter_grid_dashboard.html"/>
                                    <TextBlock Style="{StaticResource TemplateNote}"
                                               Text="수신되는 노드와 센서 카드를 자동으로 만들고, Z-Score 이상 시 해당 카드 테두리를 강조하는 반응형 그리드."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="브라우저에서 열기" VerticalAlignment="Center"
                                        Click="BtnLaunchGrid_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TemplateRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TemplateName}" Text="stream_client.html"/>
                                    <TextBlock Style="{StaticResource TemplateNote}"
                                               Text="노드 연결선을 직접 배치하는 Canvas 뷰와 타임트래블 스크러버, 리포트 생성기."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="브라우저에서 열기" VerticalAlignment="Center"
                                        Click="BtnLaunchStreamClient_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TemplateRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TemplateName}" Text="custom_dashboard.html"/>
                                    <TextBlock Style="{StaticResource TemplateNote}"
                                               Text="위젯을 끌어다 배치하고 그대로 HTML 파일로 내보내는 편집기."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="브라우저에서 열기" VerticalAlignment="Center"
                                        Click="BtnLaunchDashboard_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TemplateRow}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TemplateName}"
                                               Text="power_ups_psfb_dashboard.html (예제)"/>
                                    <TextBlock Style="{StaticResource TemplateNote}"
                                               Text="한 가지 설비를 끝까지 구현해 본 예제입니다. 계통에서 양방향 DAB(UPS·배터리)를 거쳐 PSFB 48V 랙까지 이어지는 전력 단선도, 정전 및 방전 모드 전환, 이상치 알람 콘솔."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="브라우저에서 열기" VerticalAlignment="Center"
                                        Click="BtnLaunchPowerUpsPsfb_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="템플릿 폴더 열기" Click="BtnOpenTemplateFolder_Click"/>
            <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="16,0,16,0"
                       Text="템플릿 파일은 프로젝트 폴더에 있으며, 편집기로 열어 그대로 수정할 수 있습니다."/>
            <Button Grid.Column="2" Content="닫기" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
