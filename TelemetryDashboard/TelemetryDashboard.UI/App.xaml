<Application x:Class="TelemetryDashboard.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Design Tokens (High-End Dark Slate / Cyberpunk Obsidian Palette) -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0E14"/>
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#121720"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#18202C"/>
            <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#1E2838"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#283548"/>
            <SolidColorBrush x:Key="CardBorderHighlightBrush" Color="#00F0FF"/>

            <!-- High-Contrast Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F6FC"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#484F58"/>

            <!-- Vibrant Cyberpunk Accents -->
            <SolidColorBrush x:Key="AccentBrush" Color="#00F0FF"/>
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#3300F0FF"/>
            <SolidColorBrush x:Key="AccentTealBrush" Color="#66FCF1"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#00FF9D"/>
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="#BA68C8"/>
            <SolidColorBrush x:Key="AccentWarningBrush" Color="#FFB800"/>
            <SolidColorBrush x:Key="AccentErrorBrush" Color="#FF2E63"/>

            <!-- Button Brushes -->
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1E2636"/>
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2A364C"/>
            <SolidColorBrush x:Key="ButtonPressedBrush" Color="#00F0FF"/>

            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#18202C" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#00F0FF" />

            <!-- Global Button Style -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#0B0E14"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global ToggleButton Style -->
            <Style TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0A332C"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global TextBox Style -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#0E131A"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Padding="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global Card Border Style -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
