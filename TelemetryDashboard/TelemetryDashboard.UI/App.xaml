<Application x:Class="TelemetryDashboard.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>

                <!--
                    The ribbon's captions, and the only dictionary here that is swapped at run time.
                    It is merged last so LanguageService can find it by position: everything above
                    is styling that no language changes. Korean by default, which is what the
                    application shipped with inline.
                -->
                <ResourceDictionary Source="Resources/Strings.ko-KR.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Nothing else here. There used to be a block of compatibility aliases — seventeen
                brushes redirecting the old palette's key names at the new tokens, plus a CardStyle
                — written so screens could migrate one at a time. They all migrated. The block was
                dead: no XAML and no code-behind referred to any of it, and the aliases were
                separate brush objects that took a colour once at load, so anything still using one
                would have been a control that could not follow a theme change at all.
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
