<!--
    Text styles. Five roles, and every piece of text in the application is one of them.

    The old UI had no hierarchy: section headings, field labels and live readings were all 12px
    semibold in some accent colour, so nothing stood out because everything did, and an operator
    scanning for a number had to read the words to find it. Size and weight carry the hierarchy
    here; colour is left to say what kind of thing something is, not how important it is.

    MetricText is the one that matters most on this screen. Telemetry values update several times a
    second, and in a proportional font the digits have different widths, so a reading jitters
    sideways as it changes and the eye tracks the movement instead of the value. Tabular figures
    fix the advance width and the number sits still.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Page and dialog titles. -->
    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Section headings inside a panel. Sentence case, not shouted: the old headings were all
         upper case in an accent colour, which reads as an alarm rather than a label. -->
    <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}"/>

    <!-- Field labels and units: present, subordinate, never competing with the value beside them. -->
    <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>

    <!-- Live numeric readings. Tabular figures keep the digits from shifting as the value updates. -->
    <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMetric}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- Inline numbers that sit in a sentence or a table cell rather than standing alone. -->
    <Style x:Key="MonoText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!--
        Icon glyphs. The previous interface used emoji, which is the single most reliable sign that
        nobody looked at the result: emoji render in full colour from a separate font, ignore the
        Foreground brush entirely, sit on their own baseline, and change appearance between Windows
        versions. A glyph from the system icon font inherits colour and weight like any other text.
    -->
    <Style x:Key="IconText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeIcon}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}"/>
</ResourceDictionary>
