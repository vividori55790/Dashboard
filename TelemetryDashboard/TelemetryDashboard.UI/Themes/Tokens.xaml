<!--
    Design tokens. Every colour, size and spacing value in this application resolves to something
    declared here, and nothing anywhere else declares its own.

    The rule matters more than the values. The previous UI defined a palette in App.xaml and then
    ignored it: every window wrote its own literal #00F0FF and #8B949E inline, so five accent
    colours competed on one screen, a control's disabled state was whatever its author remembered,
    and changing the theme meant a find-and-replace across two thousand lines of XAML.

    The palette is deliberately narrow: one accent, three text weights, three surface elevations.
    Status colours are reserved for status and never used for emphasis, so a red control always
    means something is wrong rather than that someone wanted it noticed.

    Why the colour is the token and the brush is only what paints with it:

    Two versions of the theme switch failed here, and the second one is the instructive one.

    It repainted each brush in the dictionary, which is right until the brushes are frozen, as
    everything loaded from compiled BAML is. Measured, not assumed: it reported "applied to 0
    brushes" in the running application while passing its tests, because the tests load this file
    through XamlReader and XamlReader does not freeze. So it replaced them instead, which reaches
    nothing already drawn, because a StaticResource reference kept the old object.

    The obvious next move is to stop freezing and let every reference hold one live brush. That was
    measured too, and it is worse: WPF cannot share an unfrozen Freezable, so it hands a private
    copy to every control a template builds. 143 of the 436 painted brushes on the running window
    stayed on the old palette. Making every reference dynamic on top of that took it to 343.

    What works, and what is written below:

      * Every brush is frozen, marked so rather than left to the loader. A frozen brush is shared,
        never copied, so one entry in this dictionary is the object the whole window paints with.

      * Its colour is a StaticResource of a Color token, resolved at parse time, so nothing is left
        unresolved that would stop the freeze. No brush states a colour of its own; an architecture
        test fails if one starts to.

      * Every reference elsewhere is DynamicResource, so replacing the entry re-resolves. That is
        what ThemeService does: it puts a new frozen brush under the key, and a new Color under the
        matching Color key for the markup that needs one. On the running window that reaches 242 of
        243 painted brushes, with none left on the old palette.

-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Surfaces: three elevations and an inset, which is all a dense tool window needs.
         More steps stop reading as depth and start reading as noise. -->
    <Color x:Key="CanvasColor">#0C0E12</Color>
    <Color x:Key="SurfaceColor">#14171C</Color>
    <Color x:Key="SurfaceAltColor">#1A1E25</Color>
    <Color x:Key="InsetColor">#090B0E</Color>

    <SolidColorBrush po:Freeze="True" x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="InsetBrush" Color="{StaticResource InsetColor}"/>

    <!-- Borders: low contrast on purpose. A 1px line at this separation reads as an edge and is
         quiet enough that forty of them on one screen still look like one interface. -->
    <Color x:Key="BorderSubtleColor">#1F2329</Color>
    <Color x:Key="BorderDefaultColor">#2A2F37</Color>
    <Color x:Key="BorderStrongColor">#3A414B</Color>

    <SolidColorBrush po:Freeze="True" x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <!-- Text: three weights of emphasis plus disabled. Anything needing a fourth is asking for a
         layout change, not another grey. -->
    <Color x:Key="TextPrimaryColor">#E8EAED</Color>
    <Color x:Key="TextSecondaryColor">#9AA1AB</Color>
    <Color x:Key="TextTertiaryColor">#6C737D</Color>
    <!-- Raised from #474D55, which was a mistake: against the surface it sits on it gave about
         2.2:1, and a row of disabled buttons was effectively unreadable rather than merely muted.
         Disabled must still be legible. An operator needs to read a command to understand why it is
         unavailable, and a control they cannot read at all reads as a rendering fault instead. -->
    <Color x:Key="TextDisabledColor">#767D87</Color>

    <SolidColorBrush po:Freeze="True" x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <!-- Accent: exactly one, and blue rather than the previous cyan-green, because the charts
         already spend green, amber and red on channel state. An accent that collides with a status
         colour makes "selected" and "alarming" look alike at a glance, which on a control surface
         is the expensive kind of ambiguity. -->
    <Color x:Key="AccentColor">#3D8BFF</Color>
    <Color x:Key="AccentHoverColor">#5C9EFF</Color>
    <Color x:Key="AccentPressedColor">#2E77E6</Color>
    <Color x:Key="AccentSubtleColor">#16233A</Color>
    <!-- What is drawn on top of the accent fill. White in both themes today, but named here rather
         than written inline, because the light theme's accent is darkened precisely so this can
         stay white: the pair is one contrast decision and has to be visible as one. -->
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <SolidColorBrush po:Freeze="True" x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>

    <!-- Status: reserved for state a machine reported. Never decoration. -->
    <Color x:Key="SuccessColor">#3FB950</Color>
    <Color x:Key="WarningColor">#D9A21B</Color>
    <Color x:Key="DangerColor">#F0524B</Color>
    <Color x:Key="InfoColor">#58A6FF</Color>

    <SolidColorBrush po:Freeze="True" x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- The quiet fill a status band sits on, which has to stay quieter than the text on top of it:
         near-black tints on the dark theme, near-white tints on the light one. -->
    <Color x:Key="SuccessSubtleColor">#132A17</Color>
    <Color x:Key="WarningSubtleColor">#2E2408</Color>
    <Color x:Key="DangerSubtleColor">#33130F</Color>
    <!-- Was written as a literal inside a Setter in Controls.xaml, which meant it could not follow
         a theme change and nothing said so. Same for the hover fill below, which lived in App.xaml. -->
    <Color x:Key="DangerBorderColor">#5C2622</Color>
    <Color x:Key="ButtonHoverColor">#20242B</Color>

    <SolidColorBrush po:Freeze="True" x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}"/>

    <!-- Scrims for the modal overlays. They own their colours rather than borrowing the canvas, and
         the light theme is the reason: a scrim dims what is behind it, and a near-white scrim over
         a near-white window dims nothing. These two stay dark in both themes. The overlays set
         their own Opacity on the element. -->
    <Color x:Key="ScrimColor">#0C0E12</Color>
    <Color x:Key="ScrimStrongColor">#090B0E</Color>

    <SolidColorBrush po:Freeze="True" x:Key="ScrimBrush" Color="{StaticResource ScrimColor}"/>
    <SolidColorBrush po:Freeze="True" x:Key="ScrimStrongBrush" Color="{StaticResource ScrimStrongColor}"/>

    <!-- Chart series: the first three stay distinguishable under the common forms of colour
         blindness. Hue alone never carries the identity of a channel; the legend does. -->
    <Color x:Key="Series1Color">#4C9AFF</Color>
    <Color x:Key="Series2Color">#F5A524</Color>
    <Color x:Key="Series3Color">#4CD4A0</Color>
    <Color x:Key="Series4Color">#C58AF9</Color>
    <Color x:Key="Series5Color">#FF7B72</Color>
    <Color x:Key="GridLineColor">#1C2027</Color>

    <SolidColorBrush po:Freeze="True" x:Key="Series1Brush" Color="{StaticResource Series1Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="Series2Brush" Color="{StaticResource Series2Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="Series3Brush" Color="{StaticResource Series3Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="Series4Brush" Color="{StaticResource Series4Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="Series5Brush" Color="{StaticResource Series5Color}"/>
    <SolidColorBrush po:Freeze="True" x:Key="GridLineBrush" Color="{StaticResource GridLineColor}"/>

    <!-- Type: Malgun Gothic is named explicitly rather than left to WPF's fallback. This interface
         is largely Korean, and letting the engine choose meant Latin and Hangul in one label picked
         different metrics and sat on visibly different baselines. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, D2Coding, Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">12</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">13</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeMetric">20</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">22</sys:Double>
    <sys:Double x:Key="FontSizeIcon">14</sys:Double>

    <!-- Metrics: a 4px rhythm, and one control height, so a row of mixed buttons, combo boxes and
         text fields lines up without anyone nudging margins by eye. -->
    <Thickness x:Key="PadXS">4</Thickness>
    <Thickness x:Key="PadS">8</Thickness>
    <Thickness x:Key="PadM">12</Thickness>
    <Thickness x:Key="PadL">16</Thickness>
    <Thickness x:Key="PadXL">24</Thickness>
    <Thickness x:Key="ControlPadding">12,6,12,6</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <sys:Double x:Key="ControlHeight">30</sys:Double>
    <sys:Double x:Key="ControlMinWidth">72</sys:Double>

    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">6</CornerRadius>
    <CornerRadius x:Key="RadiusL">8</CornerRadius>
</ResourceDictionary>
