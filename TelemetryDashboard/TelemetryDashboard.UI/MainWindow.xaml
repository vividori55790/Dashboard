<Window x:Class="TelemetryDashboard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:dockLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:controls="clr-namespace:TelemetryDashboard.UI.Controls"
        Title="TelemetryDashboard v2.0 - Enterprise Ingestion, AI Diagnosis, DVR &amp; Streaming Hub" 
        Height="880" Width="1500"
        Icon="Logo_Gemini.png"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="MainWindow_Drop" PreviewDragOver="MainWindow_PreviewDragOver"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <Style TargetType="TabItem" x:Key="RibbonTabStyle">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#8B949E" Padding="14,8"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0B0E14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Ribbon Bar -->
            <RowDefinition Height="*"/>    <!-- Central Docking Manager -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Fluent Cyberpunk Obsidian Ribbon Toolbar -->
        <Border Grid.Row="0" Background="#121720" BorderBrush="#283548" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,20,0">
                    <Image Source="Logo_Gemini.png" Width="30" Height="30" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="TELEMETRY HUB" Foreground="#00F0FF" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Enterprise Cockpit v2.0" Foreground="#8B949E" FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <!-- Ribbon Tab Control -->
                <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0">
                    <!-- Tab 1: Live Power & Telemetry Controller for HTML -->
                    <TabItem Header="⚡ 전력 데이터 제어 &amp; HTML 스트림" Style="{StaticResource RibbonTabStyle}">
                        <Border Background="#18202C" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <WrapPanel VerticalAlignment="Center">
                                <!-- Grid Outage State Controls -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Button x:Name="BtnGridNormal" Content="🟢 전력망 정상 (380V)" Padding="10,4" Background="#00FF9D" Foreground="#0B0E14" FontWeight="Bold" Click="BtnSetGridNormal_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnGridOutage" Content="🚨 정전 ➔ UPS 방전" Padding="10,4" Background="#FF2E63" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnSetGridOutage_Click"/>
                                </StackPanel>

                                <Separator Width="1" Height="24" Background="#283548" Margin="0,0,12,0"/>

                                <!-- Voltage & Load Sliders -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="400V 버스:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider x:Name="SliderDabBus" Width="70" Minimum="350" Maximum="450" Value="400" TickFrequency="10" ValueChanged="SliderDabBus_ValueChanged" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtDabBus" Text="400V" Foreground="#00F0FF" FontWeight="Bold" VerticalAlignment="Center" Width="38" Margin="0,0,8,0"/>

                                    <TextBlock Text="48V 서버:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider x:Name="SliderPsfbVolt" Width="70" Minimum="38" Maximum="54" Value="48" TickFrequency="2" ValueChanged="SliderPsfbVolt_ValueChanged" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtPsfbVolt" Text="48.0V" Foreground="#00FF9D" FontWeight="Bold" VerticalAlignment="Center" Width="42" Margin="0,0,8,0"/>

                                    <TextBlock Text="서버부하:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider x:Name="SliderServerLoad" Width="70" Minimum="10" Maximum="100" Value="82" ValueChanged="SliderServerLoad_ValueChanged" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtServerLoad" Text="82%" Foreground="#BD93F9" FontWeight="Bold" VerticalAlignment="Center" Width="32"/>
                                </StackPanel>

                                <Separator Width="1" Height="24" Background="#283548" Margin="0,0,12,0"/>

                                <!-- Anomaly Injection Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Button Content="🔥 DAB 과전류 (Z=3.8σ)" Padding="8,4" Background="#FF5555" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnInjectDabAnomaly_Click" Margin="0,0,4,0"/>
                                    <Button Content="📉 48V 전압강하 (Z=3.5σ)" Padding="8,4" Background="#FFB800" Foreground="#0B0E14" FontWeight="Bold" Click="BtnInjectPsfbAnomaly_Click" Margin="0,0,4,0"/>
                                    <Button Content="✅ 정상화" Padding="8,4" Background="#283548" Foreground="#FFFFFF" Click="BtnResetAnomaly_Click"/>
                                </StackPanel>

                                <Separator Width="1" Height="24" Background="#283548" Margin="0,0,12,0"/>

                                <!-- Open HTML Console -->
                                <Button Content="🌐 HTML 전력 콘솔 열기" Padding="12,4" Background="#00F0FF" Foreground="#0B0E14" FontWeight="Bold" Click="BtnOpenPowerUpsPsfbConsole_Click"/>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- Tab 2: Hardware Connection -->
                    <TabItem Header="🔌 하드웨어 시리얼 연결" Style="{StaticResource RibbonTabStyle}">
                        <Border Background="#18202C" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                    <TextBlock Text="포트:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboPort" Width="100" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="보드레이트:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboBaudRate" Width="90" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnRefreshPorts" Content="🔄 포트검색" Padding="8,4" Click="BtnRefreshPorts_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnAutoScan" Content="⚡ 오토스캔" Padding="8,4" Click="BtnAutoScan_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnToggleConnect" Content="🔗 연결 시작" Padding="12,4" Background="#00F0FF" Foreground="#0B0E14" FontWeight="Bold" Click="BtnToggleConnect_Click"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- Tab 2: AI Diagnosis & Time-Travel DVR -->
                    <TabItem Header="🧠 AI 진단 &amp; DVR" Style="{StaticResource RibbonTabStyle}">
                        <Border Background="#18202C" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🤖 LLM 자연어 진단 에이전트 &amp; 긴급제어" Padding="14,6" Background="#00F0FF" Foreground="#0B0E14" FontWeight="Bold" Click="BtnOpenLlmDiagnosis_Click" Margin="0,0,10,0"/>
                                <Button Content="⏱️ 0.1초 정밀 타임트래블 DVR &amp; 사고리포트" Padding="14,6" Background="#00FF9D" Foreground="#0B0E14" FontWeight="Bold" Click="BtnOpenTimeTravelDvr_Click" Margin="0,0,10,0"/>
                                <Button Content="📊 ML 통계 &amp; Z-Score 예측 모달" Padding="10,4" Margin="0,0,8,0" Click="BtnOpenMlAnalytics_Click"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- Tab 3: Alerting & Adaptive Sampling -->
                    <TabItem Header="📲 경보 &amp; 가변샘플링" Style="{StaticResource RibbonTabStyle}">
                        <Border Background="#18202C" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="📲 Slack / Discord / Telegram 경보 설정" Padding="12,6" Background="#BA68C8" Foreground="#FFF" FontWeight="Bold" Click="BtnOpenAlertForwarder_Click" Margin="0,0,10,0"/>
                                <Button Content="⚡ 1Hz ↔ 1000Hz 지능형 가변 샘플링 제어" Padding="10,4" Click="BtnAdaptiveSamplingSettings_Click" Margin="0,0,10,0"/>
                                <Button Content="🛡️ Zero-Trust AES-256 &amp; Gorilla 압축" Padding="10,4" Click="BtnSecuritySettings_Click"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- Tab 4: Mesh Cluster & Web Streaming -->
                    <TabItem Header="🌐 메쉬 &amp; 웹 스트리밍" Style="{StaticResource RibbonTabStyle}">
                        <Border Background="#18202C" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⚡ UPS DAB ⟷ DB PSFB 전력 콘솔" Padding="12,6" Background="#00FF9D" Foreground="#0B0E14" FontWeight="Bold" Click="BtnOpenPowerUpsPsfbConsole_Click" Margin="0,0,8,0"/>
                                <Button Content="📖 커스텀 웹 템플릿 &amp; SDK 가이드" Padding="10,4" Click="BtnOpenCustomWebTemplates_Click" Margin="0,0,8,0"/>
                                <Button Content="🌐 2D 노드와이어 콘솔 (stream_client.html)" Padding="10,4" Click="BtnOpenWebConsole_Click" Margin="0,0,8,0"/>
                                <Button Content="🛠️ No-Code 웹 대시보드 빌더" Padding="10,4" Click="BtnOpenNoCodeBuilder_Click" Margin="0,0,8,0"/>
                                <Button Content="🌐 P2P 분산 클러스터 &amp; WebRTC" Padding="10,4" Click="BtnOpenMeshCluster_Click" Margin="0,0,8,0"/>
                                <Button Content="📋 WebSocket URL 복사" Padding="10,4" Click="BtnCopyWsUrl_Click"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- Tab 5: Tools & OTA Flasher -->
                    <TabItem Header="⚡ 도구 &amp; OTA 플래셔" Style="{StaticResource RibbonTabStyle}">
                        <Border Background="#18202C" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⚡ 엣지 MCU 원격 OTA 플래셔" Padding="12,6" Background="#00FF9D" Foreground="#0B0E14" FontWeight="Bold" Click="BtnOpenOtaFlasher_Click" Margin="0,0,8,0"/>
                                <Button Content="🔌 핫릴로딩 플러그인 샌드박스" Padding="12,6" Background="#66FCF1" Foreground="#0B0E14" FontWeight="Bold" Click="BtnOpenPluginSandbox_Click" Margin="0,0,8,0"/>
                                <Button Content="🏭 산업용 프로토콜 브릿지" Padding="10,4" Margin="0,0,8,0" Click="BtnOpenProtocolBridge_Click"/>
                                <Button x:Name="BtnToggleRecord" Content="⏺️ 실제 CSV 디스크 녹화" Padding="10,4" Background="#18202C" Margin="0,0,8,0" Click="BtnToggleRecord_Click"/>
                                <Button Content="📈 MATLAB .mat 내보내기" Padding="10,4" Margin="0,0,8,0" Click="BtnExportMatlab_Click"/>
                                <Button Content="📁 logs/ 폴더 열기" Padding="10,4" Margin="0,0,8,0" Click="BtnOpenLogsFolder_Click"/>
                                <Button Content="🛠️ C 헤더 생성기" Padding="10,4" Margin="0,0,8,0" Click="BtnGenerateCHeader_Click"/>
                                <Button Content="🧮 수식 연산기" Padding="10,4" Click="BtnFormulaCalc_Click"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- Tab 6: Settings & Security -->
                    <TabItem Header="🔒 환경 설정" Style="{StaticResource RibbonTabStyle}">
                        <Border Background="#18202C" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔒 화면 잠금" Padding="10,4" Margin="0,0,8,0" Click="BtnLockScreen_Click"/>
                                <Button Content="🌐 언어 변경 (KOR/ENG)" Padding="10,4" Margin="0,0,8,0" Click="BtnToggleLanguage_Click"/>
                                <Button Content="🌙 다크 테마" Padding="10,4" Margin="0,0,8,0" Click="BtnToggleTheme_Click"/>
                                <Button Content="⌨️ 커맨드 팔레트 (Ctrl+Shift+P)" Padding="10,4" Click="BtnOpenCommandPalette_Click"/>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Quick Lock & Help -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0">
                    <Button Content="🔒 잠금" Padding="8,4" Click="BtnLockScreen_Click" Margin="0,0,6,0"/>
                    <Button Content="❓ 도움말" Padding="8,4" Click="BtnHelp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Central AvalonDock Docking Layout -->
        <dock:DockingManager x:Name="DockManager" Grid.Row="1" Margin="4">
            <dock:DockingManager.Layout>
                <dockLayout:LayoutRoot>
                    <dockLayout:LayoutPanel Orientation="Horizontal">
                        <dockLayout:LayoutDocumentPaneGroup>
                            <dockLayout:LayoutDocumentPane x:Name="MainDocumentPane">
                                <dockLayout:LayoutDocument Title="2D Scope &amp; Data Topology" ContentId="ScopeView" CanClose="False">
                                    <controls:ScopeViewControl x:Name="ScopeControl"/>
                                </dockLayout:LayoutDocument>
                                <dockLayout:LayoutDocument Title="📡 Streaming Server Center" ContentId="StreamingServerView" CanClose="False">
                                    <controls:StreamingServerControl x:Name="StreamingControl"/>
                                </dockLayout:LayoutDocument>
                            </dockLayout:LayoutDocumentPane>
                        </dockLayout:LayoutDocumentPaneGroup>

                        <dockLayout:LayoutAnchorablePane x:Name="RightAnchorablePane" DockWidth="400">
                            <dockLayout:LayoutAnchorable Title="Control Panel &amp; Event Log" ContentId="ControlPanel" CanClose="False">
                                <controls:ControlPanelControl x:Name="ControlPanel"/>
                            </dockLayout:LayoutAnchorable>
                        </dockLayout:LayoutAnchorablePane>
                    </dockLayout:LayoutPanel>
                </dockLayout:LayoutRoot>
            </dock:DockingManager.Layout>
        </dock:DockingManager>

        <!-- Command Palette Overlay -->
        <controls:CommandPaletteOverlay x:Name="CommandPalette" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed"/>

        <!-- Password Lock Overlay -->
        <controls:PasswordLockOverlay x:Name="LockOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"/>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0B0E14" BorderBrush="#283548" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="StatusConnectionText" Text="Status: Disconnected" Foreground="#FF2E63" FontWeight="Bold" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusPortText" Text="Port: NONE | Baud: 115200" Foreground="#8B949E" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusPacketText" Text="Rx Packets: 0 | Circuit Breaker: OK" Foreground="#8B949E" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="Press Ctrl+Shift+P for Command Palette" Foreground="#484F58" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
