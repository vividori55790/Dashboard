<!--
    The application shell: identity bar, command ribbon, docked workspace, status bar.

    Three things were rebuilt rather than adjusted.

    The tab strip wrapped onto two rows of uneven widths and drew itself in light system chrome, so
    the one strip that names every feature was the one strip that did not belong to the application.
    It is now a single row of uniformly padded tabs in a horizontal ScrollViewer: if they ever stop
    fitting they scroll, and they never wrap.

    The first tab used to be one customer's converter, welded into XAML — their grid voltage, their
    DC bus, their fault labels. It now renders from a monitoring profile, so the sliders and
    scenario buttons are whatever the selected profile describes, and a site adds its own in a JSON
    file beside the executable.

    Nothing here names a colour. Every brush is a token, which is also why the emoji had to go: they
    render from a colour font that ignores Foreground entirely, so a palette could never reach them.
-->
<Window x:Class="TelemetryDashboard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:dockLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:controls="clr-namespace:TelemetryDashboard.UI.Controls"
        Title="Telemetry Dashboard"
        Height="880" Width="1500" MinHeight="640" MinWidth="1080"
        Icon="Logo_Gemini.png"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="MainWindow_Drop" PreviewDragOver="MainWindow_PreviewDragOver"
        KeyDown="MainWindow_KeyDown"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <!--
            The ribbon's tab strip. WPF's stock TabControl hosts its headers in a TabPanel, which
            wraps to a second row and then stretches the last row's tabs to fill the width — which
            is exactly how seven tabs ended up on two rows at wildly different widths. A horizontal
            StackPanel inside a ScrollViewer keeps every tab at the width of its own caption and
            keeps them all on one line.
        -->
        <Style x:Key="RibbonTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal"
                                                Margin="8,0"/>
                                </ScrollViewer>
                            </Border>

                            <!-- MinHeight, never Height: a command row must be free to grow when a
                                 profile has more channels than the bundled ones. The floor is one
                                 control row plus this border's own padding, which is all it has to
                                 be — at 96 the shorter tabs carried a forty-pixel band of empty
                                 canvas under their buttons, and the ribbon looked broken rather
                                 than uniform. -->
                            <Border Grid.Row="1" MinHeight="56"
                                    Background="{StaticResource CanvasBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Text inside a button has to follow the button's own Foreground, otherwise a disabled
            command keeps its bright caption and there is no way to tell by looking whether it can
            be pressed. The text styles set Foreground explicitly, so inheritance alone will not do
            it and the binding is the honest fix.
        -->
        <Style x:Key="CommandIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        </Style>

        <Style x:Key="CommandLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        </Style>

        <!--
            Ribbon commands sit on a 8px gutter so a row of them reads as one group.

            BasedOn is the whole point of this style and it was missing. A keyed style with
            TargetType="Button" does not inherit the dictionary's implicit Button style — it
            replaces it — so every command carrying this style silently dropped the entire design
            system and fell back to the stock Windows button: a pale grey slab with a blue focus
            ring, in the middle of a dark application. "화면 잠금" in the identity bar sat right
            beside an unstyled "도움말" and the two looked like they came from different decades.
        -->
        <Style x:Key="RibbonCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- For commands that move hardware or overwrite something. Also the style the recorder
             toggle swaps to while it is writing, so "recording" reads as the same kind of state as
             every other irreversible command rather than as one more hand-picked red. -->
        <Style x:Key="RibbonDangerCommand" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="RibbonFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!--
            Scroll bars.

            Nothing in the theme dictionaries describes one, so every scroller in the application
            drew the stock light chrome. On the docked control panel that meant a bright white
            column the full height of the pane, hard against the right edge of the window — the
            single most conspicuous thing on a dark screen, and easy to read as the pane being
            sliced off by the window edge rather than as a scroll bar.

            No width is set here. The system metric decides how wide a scroll bar is; this only
            says what colour it is, out of the same tokens as everything else.
        -->
        <Style x:Key="ScrollPageStrip" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- Transparent but hit-testable: paging by clicking the trough still works. -->
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="{StaticResource BorderStrongBrush}"
                                CornerRadius="{StaticResource RadiusS}" Margin="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{StaticResource TextTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollPageStrip}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollPageStrip}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource ScrollPageStrip}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource ScrollPageStrip}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- identity bar -->
            <RowDefinition Height="Auto"/>  <!-- command ribbon -->
            <RowDefinition Height="*"/>     <!-- docked workspace -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ============================ Identity bar ============================ -->
        <Border Grid.Row="0" Style="{StaticResource Toolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Logo_Gemini.png" Width="24" Height="24" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Telemetry Dashboard" Style="{StaticResource SubtitleText}"
                                   Margin="0"/>
                        <!-- The subtitle says which system is being watched. It used to say
                             "Enterprise Cockpit v2.0", which told the operator nothing. -->
                        <TextBlock x:Name="ActiveProfileText" Style="{StaticResource CaptionText}"
                                   Text="프로파일 준비 중"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="화면 잠금" Click="BtnLockScreen_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Content="도움말" Click="BtnHelp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================== Command ribbon =========================== -->
        <TabControl x:Name="Ribbon" Grid.Row="1" Style="{StaticResource RibbonTabs}">

            <!-- Tab 1: the monitored system, rendered from the selected profile. -->
            <TabItem Header="시뮬레이션 프로파일">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="프로파일" Style="{StaticResource RibbonFieldLabel}"/>
                            <ComboBox x:Name="CboProfile" MinWidth="260" Margin="0,0,12,0"
                                      ItemsSource="{Binding Profiles}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="CboProfile_SelectionChanged"/>
                            <TextBlock x:Name="ProfileSummaryText" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Names what it actually toggles: the virtual dual-MCU packet stream that
                             feeds the parser, router and detector the real hardware path uses. -->
                        <Button Grid.Column="1" x:Name="BtnToggleSimulator" Content="가상 MCU 스트림 시작"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnToggleSimulator_Click"
                                ToolTip="가상 MCU 패킷을 실제 하드웨어와 같은 수집 경로로 흘려보냅니다."/>
                    </Grid>

                    <!--
                        What happened when the profile file was read, shown only when something went
                        wrong with it.

                        A picker listing only the built-in profiles looks identical whether the site
                        never wrote a profile file or wrote one the loader could not use, and the
                        second of those is a fault an operator can fix in a minute once they are told
                        which file and why. Collapsed by default and never used for the ordinary
                        no-file case, so its presence always means there is something to read.
                    -->
                    <Border x:Name="ProfileLoadBanner" Visibility="Collapsed" Margin="0,0,0,12"
                            Background="{StaticResource WarningSubtleBrush}"
                            BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusS}" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="ProfileLoadText" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Setpoints. One row per channel the profile declares; nothing about which
                         channels exist is written down here. -->
                    <ItemsControl ItemsSource="{Binding ProfileChannels}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                                    <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource RibbonFieldLabel}"/>
                                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                            Value="{Binding Value, Mode=TwoWay}"
                                            MinWidth="104" Margin="0,0,8,0"
                                            ToolTip="{Binding Range}"/>
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource MonoText}"
                                               MinWidth="72" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Scenarios, likewise generated. A scenario moves setpoints and may inject a
                         fault; the anomaly scores that follow are computed by the detector. -->
                    <ItemsControl ItemsSource="{Binding ProfileScenarios}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Apply}"
                                        ToolTip="{Binding Description}" Margin="0,0,8,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: hardware connection. -->
            <TabItem Header="연결">
                <WrapPanel>
                    <TextBlock Text="포트" Style="{StaticResource RibbonFieldLabel}"/>
                    <ComboBox x:Name="CboPort" MinWidth="150" Margin="0,0,16,0"/>

                    <TextBlock Text="보드레이트" Style="{StaticResource RibbonFieldLabel}"/>
                    <ComboBox x:Name="CboBaudRate" MinWidth="110" Margin="0,0,16,0"/>

                    <Button x:Name="BtnRefreshPorts" Click="BtnRefreshPorts_Click"
                            Style="{StaticResource RibbonCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE72C;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="포트 다시 검색"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAutoScan" Click="BtnAutoScan_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="보드레이트를 순차적으로 시도해 응답하는 조합을 찾습니다.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE721;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="보드레이트 자동 탐색"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnToggleConnect" Click="BtnToggleConnect_Click"
                            Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE71B;"/>
                            <TextBlock x:Name="ConnectButtonLabel"
                                       Style="{StaticResource CommandLabel}" Text="연결"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <!-- Tab 3: analysis and playback. -->
            <TabItem Header="분석 및 재생">
                <WrapPanel>
                    <Button Content="자연어 진단 에이전트" Click="BtnOpenLlmDiagnosis_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="이번 세션에 기록된 이상 징후를 근거로 진단을 요청합니다."/>
                    <Button Content="타임트래블 DVR" Click="BtnOpenTimeTravelDvr_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="기록된 프레임을 되감아 재생합니다."/>
                    <Button Content="이상 탐지 통계" Click="BtnOpenMlAnalytics_Click"
                            ToolTip="채널별 평균·표준편차와 Z-점수 분포를 봅니다."/>
                </WrapPanel>
            </TabItem>

            <!-- Tab 4: alerting and sampling. -->
            <TabItem Header="경보 및 샘플링">
                <WrapPanel>
                    <Button Content="경보 전달 설정" Click="BtnOpenAlertForwarder_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="Slack, Discord, Telegram 으로 경보를 전달합니다."/>
                    <Button Content="가변 샘플링 설정" Click="BtnAdaptiveSamplingSettings_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="채널 활동에 따라 샘플링 주기를 자동으로 조절합니다."/>
                    <Button Content="보안 및 압축 설정" Click="BtnSecuritySettings_Click"/>
                </WrapPanel>
            </TabItem>

            <!-- Tab 5: browser-facing consoles. -->
            <TabItem Header="웹 콘솔">
                <WrapPanel>
                    <Button Click="BtnOpenWebConsole_Click" Style="{StaticResource RibbonCommand}"
                            ToolTip="http://localhost:8080/">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE774;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="웹 클라이언트 콘솔"/>
                        </StackPanel>
                    </Button>
                    <!-- Named as the example it is. The caption used to read like the product's
                         own console, which made one customer's converter look like the subject of
                         the application rather than one of its samples. -->
                    <Button Content="전력 변환기 예제 대시보드" Click="BtnOpenPowerUpsPsfbConsole_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="번들로 제공되는 예제 페이지 power_ups_psfb_dashboard.html 을 엽니다."/>
                    <Button Content="대시보드 빌더" Click="BtnOpenNoCodeBuilder_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Content="웹 템플릿 가이드" Click="BtnOpenCustomWebTemplates_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Content="메시 클러스터" Click="BtnOpenMeshCluster_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Click="BtnCopyWsUrl_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE8C8;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="WebSocket 주소 복사"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </TabItem>

            <!-- Tab 6: tools that write to disk or to the device. -->
            <TabItem Header="도구">
                <WrapPanel>
                    <Button x:Name="BtnToggleRecord" Content="CSV 녹화 시작"
                            Click="BtnToggleRecord_Click" Style="{StaticResource RibbonCommand}"/>
                    <Button Content="MATLAB 파일로 내보내기" Click="BtnExportMatlab_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Click="BtnOpenLogsFolder_Click" Style="{StaticResource RibbonCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE8B7;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="로그 폴더 열기"/>
                        </StackPanel>
                    </Button>
                    <Button Content="C 헤더 생성" Click="BtnGenerateCHeader_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Content="수식 계산기" Click="BtnFormulaCalc_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Content="프로토콜 브릿지" Click="BtnOpenProtocolBridge_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Content="플러그인 샌드박스" Click="BtnOpenPluginSandbox_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <!-- Opens the flasher; it does not flash anything. The button that actually
                         writes to the device lives inside that dialog and is the one that earns
                         the danger style. Spending red on the entry point made an update look
                         like an alarm, and left the palette with nothing louder to say when a
                         genuine one arrives. -->
                    <Button Content="펌웨어 업데이트 (OTA)" Click="BtnOpenOtaFlasher_Click"
                            Style="{StaticResource RibbonCommand}"/>
                </WrapPanel>
            </TabItem>

            <!-- Tab 7: preferences. -->
            <TabItem Header="설정">
                <WrapPanel>
                    <Button Content="언어 전환" Click="BtnToggleLanguage_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="한국어와 영어를 번갈아 적용합니다."/>
                    <Button Content="테마 전환" Click="BtnToggleTheme_Click"
                            Style="{StaticResource RibbonCommand}"/>
                    <Button Content="레이아웃 저장" Click="BtnSaveWorkspace_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="지금의 패널 배치를 저장합니다. 창을 닫을 때도 자동으로 저장됩니다."/>
                    <Button Content="레이아웃 초기화" Click="BtnResetWorkspace_Click"
                            Style="{StaticResource RibbonCommand}"
                            ToolTip="저장된 배치를 지웁니다. 다음 시작 시 기본 배치로 돌아갑니다."/>
                    <Button Content="명령 팔레트" Click="BtnOpenCommandPalette_Click"
                            Style="{StaticResource RibbonCommand}" ToolTip="Ctrl+Shift+P"/>
                    <Button Content="화면 잠금" Click="BtnLockScreen_Click"/>
                </WrapPanel>
            </TabItem>
        </TabControl>

        <!-- ========================== Docked workspace ==========================
             Background and Foreground are set on the manager itself because AvalonDock's stock
             theme takes both from it: the anchorable pane binds straight to Manager.Background, and
             the tab headers template-bind a Foreground they inherit. Left unset, the dock drew
             itself in Windows' light system colours in the middle of a dark application. -->
        <dock:DockingManager x:Name="DockManager" Grid.Row="2" Margin="8"
                             Loaded="DockManager_Loaded"
                             Background="{StaticResource CanvasBrush}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}"
                             BorderThickness="0">
            <dock:DockingManager.Resources>
                <!-- The dock's chrome resolves the remaining greys through the system palette.
                     Redirecting those keys inside this subtree is the only lever available without
                     taking a dependency on one of the AvalonDock theme packages. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                 Color="{StaticResource SurfaceColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"
                                 Color="{StaticResource SurfaceAltColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}"
                                 Color="{StaticResource SurfaceAltColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"
                                 Color="{StaticResource BorderDefaultColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                                 Color="{StaticResource TextPrimaryColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"
                                 Color="{StaticResource TextDisabledColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                                 Color="{StaticResource CanvasColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"
                                 Color="{StaticResource TextPrimaryColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionBrushKey}"
                                 Color="{StaticResource SurfaceAltColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionTextBrushKey}"
                                 Color="{StaticResource TextPrimaryColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionBrushKey}"
                                 Color="{StaticResource SurfaceColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionTextBrushKey}"
                                 Color="{StaticResource TextSecondaryColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}"
                                 Color="{StaticResource BorderStrongColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}"
                                 Color="{StaticResource BorderSubtleColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="{StaticResource AccentSubtleColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="{StaticResource TextPrimaryColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"
                                 Color="{StaticResource SurfaceColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"
                                 Color="{StaticResource TextPrimaryColor}"/>
            </dock:DockingManager.Resources>

            <dock:DockingManager.Layout>
                <dockLayout:LayoutRoot>
                    <dockLayout:LayoutPanel Orientation="Horizontal">
                        <dockLayout:LayoutDocumentPaneGroup>
                            <dockLayout:LayoutDocumentPane x:Name="MainDocumentPane">
                                <dockLayout:LayoutDocument Title="실시간 파형" ContentId="ScopeView" CanClose="False">
                                    <controls:ScopeViewControl x:Name="ScopeControl"/>
                                </dockLayout:LayoutDocument>
                                <dockLayout:LayoutDocument Title="스트리밍 서버" ContentId="StreamingServerView" CanClose="False">
                                    <controls:StreamingServerControl x:Name="StreamingControl"/>
                                </dockLayout:LayoutDocument>
                                <!--
                                    The digital twin. The control was complete - toolbar, viewport,
                                    lights, grid - and had no window anywhere in this shell, so it
                                    had never once appeared in the running application, while
                                    LayoutPreset.Twin3DMode offered to arrange the workspace around
                                    it. A pane is all it was ever missing.
                                -->
                                <dockLayout:LayoutDocument Title="디지털 트윈" ContentId="Twin3DView" CanClose="False">
                                    <controls:DigitalTwin3DViewControl x:Name="TwinControl"/>
                                </dockLayout:LayoutDocument>
                            </dockLayout:LayoutDocumentPane>
                        </dockLayout:LayoutDocumentPaneGroup>

                        <!--
                            The right pane was 400px with no minimum and no scrolling, so on a
                            1536-wide display its labels were cut mid-word — "Control Panel &",
                            "PACKET COUNT", "MCU COMM" — and anything below the fold was simply
                            gone. It now has room and a floor it cannot be dragged below.

                            The anchorable holds the panel directly. It used to be wrapped in a
                            ScrollViewer, and that wrapper was what made the pane look sliced: the
                            panel already scrolls internally and pins its status line to its own
                            bottom edge, so the outer viewer measured it against infinite height,
                            the internal scroller never engaged, the pinned line was pushed below
                            the fold, and the whole panel became one tall strip. Then every
                            telemetry tick called ScrollIntoView on the event log, whose
                            RequestBringIntoView bubbled out of the list and dragged that outer
                            strip upward — so within a second of launch the pane opened part-way
                            down its own content, with "Live readings" and the packet and rate
                            tiles scrolled off the top, and a stock white scroll bar standing the
                            full height of the window's right edge.
                        -->
                        <dockLayout:LayoutAnchorablePane x:Name="RightAnchorablePane"
                                                         DockWidth="460" DockMinWidth="380">
                            <dockLayout:LayoutAnchorable Title="제어 및 이벤트 로그" ContentId="ControlPanel" CanClose="False">
                                <controls:ControlPanelControl x:Name="ControlPanel"/>
                            </dockLayout:LayoutAnchorable>
                        </dockLayout:LayoutAnchorablePane>
                    </dockLayout:LayoutPanel>
                </dockLayout:LayoutRoot>
            </dock:DockingManager.Layout>
        </dock:DockingManager>

        <!-- ============================== Status bar ============================= -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Red because the machine is reporting a state, not for emphasis. -->
                    <TextBlock x:Name="StatusConnectionText" Text="연결 안 됨"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource DangerBrush}" Margin="0,0,20,0"/>
                    <TextBlock x:Name="StatusPortText" Text="포트 없음"
                               Style="{StaticResource CaptionText}" Margin="0,0,20,0"/>
                    <!-- Says only what the recorder reports. It used to read "Rx Packets: 0 |
                         Circuit Breaker: OK", where the packet count only ever moved during a
                         recording and the breaker state was never asked for at all. -->
                    <TextBlock x:Name="StatusRecordingText" Text="녹화 중지"
                               Style="{StaticResource CaptionText}"/>
                </StackPanel>
                <TextBlock Text="Ctrl+Shift+P — 명령 팔레트" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Overlays last so they sit above the workspace they cover. -->
        <!-- Alarm banner. Over the workspace rather than in a panel, because the panel it used to
             write into is beside the chart the operator is watching, not in it. A critical alert
             stays until it is dismissed: one that clears itself is one they can be shown and still
             never see. -->
        <Border x:Name="AlertBanner" Grid.Row="2" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,16,16,0"
                BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="14,10"
                Panel.ZIndex="50">
            <DockPanel>
                <TextBlock x:Name="AlertBannerIcon" DockPanel.Dock="Left"
                           Style="{StaticResource IconText}" Text="&#xE7BA;"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button DockPanel.Dock="Right" Content="확인" Click="BtnDismissAlert_Click"
                        AutomationProperties.Name="Dismiss alert"
                        Style="{StaticResource RibbonCommand}" Margin="12,0,0,0"/>
                <TextBlock x:Name="AlertBannerText" Style="{StaticResource MonoText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Text=""/>
            </DockPanel>
        </Border>

        <controls:CommandPaletteOverlay x:Name="CommandPalette" Grid.Row="2"
                                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                        Visibility="Collapsed"/>
        <controls:PasswordLockOverlay x:Name="LockOverlay" Grid.Row="0" Grid.RowSpan="4"
                                      Visibility="Collapsed"/>
    </Grid>
</Window>
