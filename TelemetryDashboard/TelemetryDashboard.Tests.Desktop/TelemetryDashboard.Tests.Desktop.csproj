<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows-only half of the suite.

    TelemetryDashboard.Tests used to target net8.0-windows purely because it referenced the WPF
    shell, which made all 590 tests unrunnable off Windows and left the "Core, Infrastructure and
    Plugins are portable" claim permanently unverified. Only the tests that actually construct a
    WPF-dependent type live here; everything else stays in the portable project so a Linux CI agent
    can run it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>TelemetryDashboard.Tests.Desktop</RootNamespace>
    <AssemblyName>TelemetryDashboard.Tests.Desktop</AssemblyName>
    <NoWarn>$(NoWarn);NU1701;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Xunit.StaFact" Version="1.1.11" />
  </ItemGroup>

  <!--
    Linked, not copied. A second copy of MockSerialDevice or TestDataGenerator would drift the first
    time one of them is fixed, and the two suites would then disagree about what a valid frame looks
    like. Linking keeps exactly one definition compiled into both assemblies.

    WpfTestFactAttribute.cs is the exception and is owned outright by this project: its helpers call
    Thread.SetApartmentState, which exists only on Windows, so linking it back into the portable
    project would reintroduce the platform dependency this split removed.
  -->
  <ItemGroup>
    <Compile Include="..\TelemetryDashboard.Tests\GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="..\TelemetryDashboard.Tests\TestUtilities\*.cs"
             Link="TestUtilities\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelemetryDashboard.Core\TelemetryDashboard.Core.csproj" />
    <ProjectReference Include="..\TelemetryDashboard.Infrastructure\TelemetryDashboard.Infrastructure.csproj" />
    <ProjectReference Include="..\TelemetryDashboard.Plugins\TelemetryDashboard.Plugins.csproj" />
    <ProjectReference Include="..\TelemetryDashboard.UI\TelemetryDashboard.UI.csproj" />
  </ItemGroup>

</Project>
