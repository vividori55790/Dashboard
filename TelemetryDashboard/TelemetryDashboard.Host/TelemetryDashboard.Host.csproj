<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TelemetryDashboard.Host</RootNamespace>
    <AssemblyName>TelemetryDashboard.Host</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <NoWarn>$(NoWarn);NU1701;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The browser console assets, staged beside the executable so the host has something to serve
      out of the box. They are the same files the desktop shell copies; linking them here keeps a
      single source of truth instead of a second copy that drifts.
    -->
    <Content Include="..\..\*.html">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\telemetry-client.js">
      <Link>telemetry-client.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelemetryDashboard.Core\TelemetryDashboard.Core.csproj" />
    <ProjectReference Include="..\TelemetryDashboard.Infrastructure\TelemetryDashboard.Infrastructure.csproj" />

    <!--
      Build order only, for the reason ArchitectureRuleTests.HostDoesNotCompileAgainstThePluginProject
      states for the desktop host: compiling against the plugin puts it on the default
      AssemblyLoadContext's probing path, where it is loaded into a context that never unloads and
      hot reload stops working silently. A host must discover plugins as files it was not built
      against, which is exactly the path a third-party plugin takes. StagePlugins puts the output
      where that discovery looks.
    -->
    <ProjectReference Include="..\TelemetryDashboard.Plugins\TelemetryDashboard.Plugins.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Copies the sample plugin into the host's plugins/ directory, where plugin discovery looks.

    RuntimeIdentifier is cleared deliberately. `dotnet publish -r linux-x64` sets it as a global
    property that flows into this MSBuild call, so GetTargetPath answers with a RID-qualified path
    the plugin project never built to and the publish fails on a missing file. The plugin is a
    plain net8.0 library with one output for every RID, so asking for it without a RID is both
    correct and the only thing that works when cross-publishing.
  -->
  <Target Name="StagePlugins" AfterTargets="Build">
    <MSBuild Projects="..\TelemetryDashboard.Plugins\TelemetryDashboard.Plugins.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false">
      <Output TaskParameter="TargetOutputs" ItemName="StagedPluginAssembly" />
    </MSBuild>

    <Copy SourceFiles="@(StagedPluginAssembly)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    The same staging for `dotnet publish`. Publish does not carry OutDir content across, so without
    this the published host is the one people actually deploy and the only one with no plugins
    directory - discovery would find nothing on every machine that matters.
  -->
  <Target Name="StagePluginsForPublish" AfterTargets="Publish" DependsOnTargets="StagePlugins">
    <Copy SourceFiles="@(StagedPluginAssembly)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
